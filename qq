// slimPythonEmbed.js - VS Code 扩展用 Python Embed 精简工具
const fs = require('fs').promises;
const path = require('path');
const { execSync } = require('child_process');

/**
 * Python Embed 精简器（跨平台）
 */
class PythonEmbedSlimmer {
    constructor(pythonRoot, options = {}) {
        this.pythonRoot = path.resolve(pythonRoot);
        this.options = {
            removeSourceFiles: false,  // 是否删除 .py 源文件
            verbose: true,             // 是否输出详细日志
            ...options
        };

        // 跨平台路径处理
        this.libDir = path.join(this.pythonRoot, 'Lib');
        this.pythonExe = this.getPythonExecutable();

        // 要删除的标准库包
        this.packagesToRemove = [
            'idlelib',
            'test',
            'ensurepip',
            'pydoc_data',
            'unittest',
            'venv',
            'lib2to3',
            'distutils'
        ];

        this.stats = {
            initialSize: 0,
            removedSize: 0,
            pycCount: 0,
            pyRemovedCount: 0
        };
    }

    /**
     * 跨平台获取 Python 可执行文件路径
     */
    getPythonExecutable() {
        const isWindows = process.platform === 'win32';
        const exeName = isWindows ? 'python.exe' : 'python3';

        // 优先查找 Embed 目录下的 python
        let pythonPath = path.join(this.pythonRoot, exeName);
        if (this.fileExistsSync(pythonPath)) {
            return pythonPath;
        }

        // 兼容 bin/ 子目录（Linux/macOS）
        pythonPath = path.join(this.pythonRoot, 'bin', exeName);
        if (this.fileExistsSync(pythonPath)) {
            return pythonPath;
        }

        throw new Error(`找不到 Python 可执行文件：${this.pythonRoot}`);
    }

    /**
     * 同步检查文件是否存在（兼容旧 Node.js）
     */
    fileExistsSync(filePath) {
        try {
            require('fs').accessSync(filePath, require('fs').constants.F_OK);
            return true;
        } catch {
            return false;
        }
    }

    /**
     * 递归计算目录大小（字节）
     */
    async getDirectorySize(dirPath) {
        let totalSize = 0;

        try {
            const entries = await fs.readdir(dirPath, { withFileTypes: true });

            for (const entry of entries) {
                const fullPath = path.join(dirPath, entry.name);

                if (entry.isDirectory()) {
                    totalSize += await this.getDirectorySize(fullPath);
                } else if (entry.isFile()) {
                    const stats = await fs.stat(fullPath);
                    totalSize += stats.size;
                }
            }
        } catch (error) {
            // 忽略权限错误
            if (error.code !== 'EACCES' && error.code !== 'EPERM') {
                throw error;
            }
        }

        return totalSize;
    }

    /**
     * 递归删除目录
     */
    async removeDirectory(dirPath) {
        try {
            // Node.js 14.14+ 支持 recursive 选项
            await fs.rm(dirPath, { recursive: true, force: true });
            return true;
        } catch (error) {
            // 降级到手动递归删除（兼容旧版本）
            try {
                const entries = await fs.readdir(dirPath, { withFileTypes: true });

                for (const entry of entries) {
                    const fullPath = path.join(dirPath, entry.name);

                    if (entry.isDirectory()) {
                        await this.removeDirectory(fullPath);
                    } else {
                        await fs.unlink(fullPath);
                    }
                }

                await fs.rmdir(dirPath);
                return true;
            } catch (innerError) {
                this.log(`删除失败：${dirPath} - ${innerError.message}`, 'error');
                return false;
            }
        }
    }

    /**
     * 日志输出
     */
    log(message, level = 'info') {
        if (!this.options.verbose && level === 'info') return;

        const prefix = {
            'info': '  ',
            'success': '✓ ',
            'warning': '⚠ ',
            'error': '✗ '
        }[level] || '  ';

        console.log(`${prefix}${message}`);
    }

    /**
     * 步骤 1：删除无用的标准库包
     */
    async removePackages() {
        this.log('\n========================================', 'info');
        this.log('步骤 1/3：删除无用标准库包', 'info');
        this.log('========================================', 'info');

        for (const pkgName of this.packagesToRemove) {
            const pkgPath = path.join(this.libDir, pkgName);

            try {
                await fs.access(pkgPath);

                // 计算大小
                const size = await this.getDirectorySize(pkgPath);

                // 删除
                const success = await this.removeDirectory(pkgPath);

                if (success) {
                    this.stats.removedSize += size;
                    this.log(
                        `已删除：${pkgName.padEnd(20)} (${(size / 1024 / 1024).toFixed(2)} MB)`,
                        'success'
                    );
                }
            } catch (error) {
                if (error.code === 'ENOENT') {
                    this.log(`跳过（不存在）：${pkgName}`, 'info');
                } else {
                    this.log(`跳过（无法删除）：${pkgName} - ${error.message}`, 'warning');
                }
            }
        }

        this.log(
            `\n累计释放空间：${(this.stats.removedSize / 1024 / 1024).toFixed(2)} MB`,
            'success'
        );
    }

    /**
     * 步骤 2：预编译 .pyc 字节码
     */
    async compilePyc() {
        this.log('\n========================================', 'info');
        this.log('步骤 2/3：预编译字节码（.pyc）', 'info');
        this.log('========================================', 'info');

        try {
            // 执行编译命令
            this.log('正在编译...', 'info');

            const compileCommand = `"${this.pythonExe}" -m compileall -q "${this.libDir}"`;

            execSync(compileCommand, {
                stdio: 'pipe',
                encoding: 'utf-8',
                timeout: 60000  // 60 秒超时
            });

            // 统计生成的 .pyc 文件
            this.stats.pycCount = await this.countFiles(this.libDir, '.pyc');

            this.log(`编译完成，生成 ${this.stats.pycCount} 个 .pyc 文件`, 'success');

            return true;
        } catch (error) {
            this.log(`编译失败：${error.message}`, 'error');
            this.log('提示：跳过此步骤不影响功能，仅首次启动会慢', 'warning');
            return false;
        }
    }

    /**
     * 步骤 3：删除 .py 源文件（可选）
     */
    async removeSourceFiles() {
        if (!this.options.removeSourceFiles) {
            this.log('\n跳过删除 .py 源文件（保留以便调试）', 'info');
            return;
        }

        this.log('\n========================================', 'info');
        this.log('步骤 3/3：删除 .py 源文件', 'info');
        this.log('========================================', 'info');
        this.log('⚠️  警告：删除后无法调试！', 'warning');

        try {
            const pyFiles = await this.findFiles(this.libDir, '.py');

            for (const pyFile of pyFiles) {
                await fs.unlink(pyFile);
            }

            this.stats.pyRemovedCount = pyFiles.length;
            this.log(`已删除 ${this.stats.pyRemovedCount} 个 .py 源文件`, 'success');
        } catch (error) {
            this.log(`删除 .py 文件失败：${error.message}`, 'error');
        }
    }

    /**
     * 递归查找特定扩展名的文件
     */
    async findFiles(dirPath, extension) {
        const results = [];

        try {
            const entries = await fs.readdir(dirPath, { withFileTypes: true });

            for (const entry of entries) {
                const fullPath = path.join(dirPath, entry.name);

                if (entry.isDirectory()) {
                    const subFiles = await this.findFiles(fullPath, extension);
                    results.push(...subFiles);
                } else if (entry.name.endsWith(extension)) {
                    results.push(fullPath);
                }
            }
        } catch (error) {
            // 忽略访问错误
        }

        return results;
    }

    /**
     * 统计特定扩展名的文件数量
     */
    async countFiles(dirPath, extension) {
        const files = await this.findFiles(dirPath, extension);
        return files.length;
    }

    /**
     * 主入口：执行完整精简流程
     */
    async run() {
        console.log('\n' + '='.repeat(60));
        console.log('   Python Embed 精简工具 (VS Code 扩展版)');
        console.log('='.repeat(60));
        this.log(`目标目录：${this.pythonRoot}`, 'info');
        this.log(`Python 可执行文件：${this.pythonExe}`, 'info');

        // 验证环境
        if (!this.fileExistsSync(this.libDir)) {
            throw new Error(`找不到 Lib 目录：${this.libDir}`);
        }

        // 记录初始大小
        this.stats.initialSize = await this.getDirectorySize(this.pythonRoot);
        this.log(`初始体积：${(this.stats.initialSize / 1024 / 1024).toFixed(2)} MB\n`, 'info');

        // 执行三步操作
        await this.removePackages();
        await this.compilePyc();
        await this.removeSourceFiles();

        // 计算最终大小
        const finalSize = await this.getDirectorySize(this.pythonRoot);
        const savedSize = this.stats.initialSize - finalSize;
        const savedPercent = ((savedSize / this.stats.initialSize) * 100).toFixed(1);

        // 输出总结
        console.log('\n' + '='.repeat(60));
        this.log('精简完成！', 'success');
        console.log('='.repeat(60));
        this.log(`最终体积：${(finalSize / 1024 / 1024).toFixed(2)} MB`, 'info');
        this.log(`节省空间：${(savedSize / 1024 / 1024).toFixed(2)} MB (${savedPercent}%)`, 'success');
        console.log('='.repeat(60) + '\n');

        return {
            success: true,
            stats: {
                initialSize: this.stats.initialSize,
                finalSize: finalSize,
                savedSize: savedSize,
                savedPercent: parseFloat(savedPercent),
                pycCount: this.stats.pycCount,
                pyRemovedCount: this.stats.pyRemovedCount
            }
        };
    }
}

// ==================== 导出模块 ====================

/**
 * 简化接口：直接调用精简
 * @param {string} pythonRoot - Python Embed 根目录
 * @param {object} options - 配置选项
 * @returns {Promise<object>} - 执行结果
 */
async function slimPythonEmbed(pythonRoot, options = {}) {
    const slimmer = new PythonEmbedSlimmer(pythonRoot, options);
    return await slimmer.run();
}

// 支持 CommonJS 和 ES Module
if (typeof module !== 'undefined' && module.exports) {
    module.exports = {
        PythonEmbedSlimmer,
        slimPythonEmbed
    };
}

// ==================== 独立脚本支持 ====================

// 如果作为独立脚本运行
if (require.main === module) {
    const args = process.argv.slice(2);

    if (args.length === 0) {
        console.error('用法：node slimPythonEmbed.js <Python根目录> [--remove-py]');
        console.error('示例：node slimPythonEmbed.js /path/to/python38');
        console.error('      node slimPythonEmbed.js C:\\python38 --remove-py');
        process.exit(1);
    }

    const pythonRoot = args[0];
    const removeSourceFiles = args.includes('--remove-py');

    slimPythonEmbed(pythonRoot, { removeSourceFiles })
        .then(result => {
            process.exit(result.success ? 0 : 1);
        })
        .catch(error => {
            console.error(`\n❌ 错误：${error.message}`);
            process.exit(1);
        });
}
