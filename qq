## 6) 一份可直接用的 VS Code BrokerClient（TypeScript）

这段代码包含：

* 自动解析 JSONL
* `_id -> Promise` 映射
* `hello` 校验
* 心跳续租（每 25 秒发一次 hello）
* 断线时可重连（你可以在外面包一层重连策略）

```ts
import * as net from "net";

type EndpointInfo =
  | { family: "pipe"; name: string }
  | { family: "unix"; path: string };

type Pending = {
  resolve: (v: any) => void;
  reject: (e: any) => void;
  timer?: NodeJS.Timeout;
};

export class BrokerClient {
  private sock: net.Socket | null = null;
  private inbuf = "";
  private nextId = 1;
  private pending = new Map<number, Pending>();
  private heartbeatTimer: NodeJS.Timeout | null = null;

  constructor(
    private endpoint: EndpointInfo,
    private token: string,
    private clientId: string
  ) {}

  async connect(): Promise<void> {
    if (this.sock) return;

    const target = this.endpoint.family === "pipe" ? this.endpoint.name : this.endpoint.path;

    this.sock = net.createConnection(target);
    this.sock.setNoDelay(true);

    this.sock.on("data", (buf) => this.onData(buf));
    this.sock.on("error", (err) => this.onError(err));
    this.sock.on("close", () => this.onClose());

    await new Promise<void>((resolve, reject) => {
      this.sock!.once("connect", () => resolve());
      this.sock!.once("error", reject);
    });

    // 连接成功后，先 hello 验证 token & app_id
    const hello = await this.request({ action: "hello" }, 1200);
    if (!hello?.ok || hello.app_id !== "vix-broker") {
      throw new Error("Broker hello failed / wrong app_id");
    }

    // 心跳续租：TTL=80s，这里 25s 一次很稳
    this.heartbeatTimer = setInterval(() => {
      // 心跳失败不抛出，交给 close/error 处理
      this.request({ action: "hello" }, 1000).catch(() => {});
    }, 25_000);
  }

  close() {
    if (this.heartbeatTimer) clearInterval(this.heartbeatTimer);
    this.heartbeatTimer = null;

    if (this.sock) {
      try { this.sock.destroy(); } catch {}
    }
    this.sock = null;

    // 清掉所有 pending
    for (const [id, p] of this.pending.entries()) {
      if (p.timer) clearTimeout(p.timer);
      p.reject(new Error("Socket closed"));
    }
    this.pending.clear();
  }

  async request(payload: any, timeoutMs = 5000): Promise<any> {
    if (!this.sock) throw new Error("Not connected");

    const id = this.nextId++;
    const msg = {
      _id: id,
      client_id: this.clientId,
      token: this.token,
      ...payload,
    };

    const line = JSON.stringify(msg) + "\n";

    const p = new Promise<any>((resolve, reject) => {
      const pending: Pending = { resolve, reject };
      if (timeoutMs > 0) {
        pending.timer = setTimeout(() => {
          this.pending.delete(id);
          reject(new Error(`Timeout: ${payload?.action ?? "?"}`));
        }, timeoutMs);
      }
      this.pending.set(id, pending);
    });

    this.sock.write(line, "utf8");
    return p;
  }

  private onData(buf: Buffer) {
    this.inbuf += buf.toString("utf8");
    while (true) {
      const idx = this.inbuf.indexOf("\n");
      if (idx < 0) break;
      const line = this.inbuf.slice(0, idx).trim();
      this.inbuf = this.inbuf.slice(idx + 1);

      if (!line) continue;

      let obj: any;
      try {
        obj = JSON.parse(line);
      } catch {
        continue;
      }

      const id = obj?._id;
      if (typeof id === "number" && this.pending.has(id)) {
        const p = this.pending.get(id)!;
        this.pending.delete(id);
        if (p.timer) clearTimeout(p.timer);
        p.resolve(obj);
      } else {
        // broker 模式下通常不会有“无 _id 的事件”
        // 如果未来扩展事件推送，可在这里处理
      }
    }
  }

  private onError(err: any) {
    // 这里不要疯狂 reject 全部 pending，否则会重复触发 close
    // 你也可以选择立即 close
  }

  private onClose() {
    this.close();
  }
}
```

