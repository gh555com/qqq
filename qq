## 7) VS Code 侧：如何读 endpoint/token（推荐写法）

你可以按系统拼路径：

```ts
import * as os from "os";
import * as path from "path";
import * as fs from "fs";

const DIR = "vix_audio_broker";

export function getBrokerDir(): string {
  if (process.platform === "win32") {
    const base =
      process.env.LOCALAPPDATA ||
      process.env.APPDATA ||
      os.tmpdir();
    return path.join(base, DIR);
  }
  const base = process.env.XDG_CACHE_HOME || path.join(os.homedir(), ".cache");
  return path.join(base, DIR);
}

export function readTokenAndEndpoint(): { token: string; endpoint: any } {
  const dir = getBrokerDir();
  const token = fs.readFileSync(path.join(dir, "token.txt"), "utf8").trim();
  const endpoint = JSON.parse(fs.readFileSync(path.join(dir, "endpoint.json"), "utf8"));
  return { token, endpoint };
}
```

> 注意：第一次启动 broker 前，这两个文件可能不存在。
> 所以你的 `ensureBrokerRunning()` 里要能处理 “读不到 -> spawn -> 再读”。

