### 5. ID 查找优化 (A: 3分 vs Q: 9分)

```javascript
// ========== 代码 A ==========
getItemById(id) {
    return this.history.find(item => item.id === id);  // O(n)
}

// ========== 代码 Q ==========
buildIdMap() {
    this.idMap = {};
    for (let i = 0; i < this.history.length; i++) {
        this.idMap[this.history[i].id] = i;  // O(1) 查找
    }
}

getItemById(id) {
    if (this.idMap[id] !== undefined) {
        return this.history[this.idMap[id]];  // O(1)
    }
}
```

