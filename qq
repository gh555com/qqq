## ① Python daemon：加上音量控制（关键补丁）

### A. 在 `NonBlockingAudioEngine.__init__` 里新增两个字段

把下面两行加到 `__init__` 末尾合适位置（比如 `_stop_event` 后）：

```python
        self._volume = 1.0
        self._volume_lock = threading.Lock()
```

### B. 在 `NonBlockingAudioEngine` 类里新增 3 个方法

```python
    def set_volume(self, v: float):
        try:
            v = float(v)
        except Exception:
            v = 1.0
        if v < 0.0:
            v = 0.0
        if v > 1.0:
            v = 1.0

        with self._volume_lock:
            self._volume = v

        # 立即作用到当前所有设备
        with self._lock:
            devices = list(self.active_devices)
        for d in devices:
            try:
                d.volume = v
            except Exception:
                pass
        return v

    def get_volume(self) -> float:
        with self._volume_lock:
            return float(self._volume)

    def fade_out_and_stop(self, fade_ms: int = 2000, step_ms: int = 20):
        # 没有设备就直接停
        with self._lock:
            devices = list(self.active_devices)
        if not devices:
            self.stop_all()
            return

        fade_ms = int(fade_ms) if fade_ms else 0
        if fade_ms <= 0:
            self.stop_all()
            return

        steps = max(1, int(fade_ms // step_ms))
        base = self.get_volume()

        for i in range(steps):
            factor = 1.0 - ((i + 1) / steps)  # 1 -> 0
            vol = base * factor
            with self._lock:
                devices = list(self.active_devices)
            for d in devices:
                try:
                    d.volume = vol
                except Exception:
                    pass
            time.sleep(step_ms / 1000.0)

        self.stop_all()
        # 为下一次播放还原“逻辑音量”
        self.set_volume(base)
```

