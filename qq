import * as vscode from 'vscode';
import * as os from 'os';
import * as net from 'net';
import { execFile, ChildProcess } from 'child_process';

// ====== 规则参数 ======
const THRESHOLD_BYTES = 11 * 1024 * 1024; // >11MB 才更新 UI
const INTERVAL_LOW_MS = 6000;
const INTERVAL_HIGH_MS = 22000;
const HIGH_GB = 8;

// daemon（可改成你们现有的）
const PIPE_NAME = '\\\\.\\pipe\\q2-diskfree';

// legacy previewHtml 的 URI
const LEGACY_SCHEME = 'q2';
const LEGACY_PATH = 'panel.html';

// ====== 工具函数 ======
function bytesToGB(b: number) { return b / (1024 * 1024 * 1024); }
function fmtGB(bytes: number) { const gb = bytesToGB(bytes); return gb >= 10 ? gb.toFixed(2) : gb.toFixed(3); }
function pickIntervalMs(free: number) { return bytesToGB(free) > HIGH_GB ? INTERVAL_HIGH_MS : INTERVAL_LOW_MS; }

function getSystemDriveLetter(): string {
  const sd = process.env.SystemDrive;
  if (sd && sd.length > 0) return sd[0].toUpperCase();
  return 'C';
}

// ====== Webview HTML（现代） ======
function getModernWebviewHtml(): string {
  return `<!doctype html><html><head>
<meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<style>body{font-family:sans-serif;padding:12px}.v{font-size:20px}.s{opacity:.7;margin-top:8px}</style>
</head><body>
<div class="v" id="val">C: --</div><div class="s" id="st">...</div>
<script>
  const vscode = acquireVsCodeApi();
  function reportVis(){ vscode.postMessage({type:'q2Vis', visible: document.visibilityState==='visible'}); }
  document.addEventListener('visibilitychange', reportVis);
  window.addEventListener('focus', reportVis);
  window.addEventListener('blur', reportVis);
  reportVis();

  window.addEventListener('message', (ev)=>{
    const m = ev.data || {};
    if (m.type === 'disk') {
      document.getElementById('val').textContent = m.text;
      document.getElementById('st').textContent = m.sub || '';
    }
  });
</script>
</body></html>`;
}

// ====== Legacy HTML（previewHtml） ======
function getLegacyHtml(text: string, sub: string): string {
  // previewHtml 下没法 acquireVsCodeApi() 做消息，所以我们只能“重渲染整个 HTML”
  return `<!doctype html><html><head>
<meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>q2</title>
<style>body{font-family:sans-serif;padding:12px}.v{font-size:20px}.s{opacity:.7;margin-top:8px}</style>
</head><body>
<div class="v">${escapeHtml(text)}</div>
<div class="s">${escapeHtml(sub || '')}</div>
</body></html>`;
}
function escapeHtml(s: string): string {
  return (s || '').replace(/[&<>"']/g, (c) => {
    switch (c) {
      case '&': return '&amp;';
      case '<': return '&lt;';
      case '>': return '&gt;';
      case '"': return '&quot;';
      case "'": return '&#39;';
      default: return c;
    }
  });
}

// ====== 读盘：daemon -> powershell -> wmic -> fsutil ======
function queryFromDaemonPipe(driveLetter: string, timeoutMs: number, killToken: { sock?: net.Socket | null }): Promise<number> {
  return new Promise((resolve, reject) => {
    const dl = (driveLetter || 'C').toUpperCase().replace(/[^A-Z]/g, '') || 'C';
    const sock = net.createConnection(PIPE_NAME);
    killToken.sock = sock;

    let done = false;
    let buf = '';

    const t = setTimeout(() => {
      if (done) return;
      done = true;
      try { sock.destroy(); } catch {}
      reject(new Error('daemon timeout'));
    }, timeoutMs);

    sock.on('error', (e) => {
      if (done) return;
      done = true;
      clearTimeout(t);
      reject(e);
    });

    sock.on('data', (d) => { buf += String(d); });

    sock.on('connect', () => {
      sock.write(dl + '\n');
    });

    sock.on('close', () => {
      if (done) return;
      done = true;
      clearTimeout(t);
      const s = buf.trim();
      const n = Number(s);
      if (!Number.isFinite(n) || n < 0) return reject(new Error('bad daemon response: ' + s));
      resolve(n);
    });
  });
}

function queryByExecWindows(driveLetter: string, killToken: { child?: ChildProcess | null }): Promise<number> {
  return new Promise((resolve, reject) => {
    const dl = (driveLetter || 'C').toUpperCase().replace(/[^A-Z]/g, '') || 'C';

    // 先 PowerShell
    const ps = `[Console]::Write([System.IO.DriveInfo]::new('${dl}').AvailableFreeSpace)`;
    const child = execFile('powershell.exe',
      ['-NoProfile', '-NonInteractive', '-ExecutionPolicy', 'Bypass', '-Command', ps],
      { windowsHide: true, timeout: 1500 },
      () => {}
    );
    killToken.child = child;

    let buf = '';
    child.stdout && child.stdout.on('data', (d) => buf += String(d));
    child.stderr && child.stderr.on('data', (d) => buf += String(d));

    child.on('error', () => {
      // powershell 不行就 wmic
      fallbackWMIC(dl, killToken).then(resolve, reject);
    });

    child.on('close', () => {
      const out = String(buf).trim();
      const n = Number(out);
      if (Number.isFinite(n) && n >= 0) return resolve(n);
      fallbackWMIC(dl, killToken).then(resolve, reject);
    });
  });
}

function fallbackWMIC(dl: string, killToken: { child?: ChildProcess | null }): Promise<number> {
  return new Promise((resolve, reject) => {
    const child = execFile('wmic',
      ['logicaldisk', 'where', `DeviceID='${dl}:'`, 'get', 'FreeSpace', '/value'],
      { windowsHide: true, timeout: 2000 },
      () => {}
    );
    killToken.child = child;

    let buf = '';
    child.stdout && child.stdout.on('data', (d) => buf += String(d));
    child.stderr && child.stderr.on('data', (d) => buf += String(d));

    child.on('error', () => fallbackFsutil(dl, killToken).then(resolve, reject));
    child.on('close', () => {
      const out = String(buf).trim();
      const m = out.match(/FreeSpace\s*=\s*(\d+)/i);
      if (m) return resolve(Number(m[1]));
      fallbackFsutil(dl, killToken).then(resolve, reject);
    });
  });
}

function fallbackFsutil(dl: string, killToken: { child?: ChildProcess | null }): Promise<number> {
  return new Promise((resolve, reject) => {
    const child = execFile('fsutil',
      ['volume', 'diskfree', `${dl}:`],
      { windowsHide: true, timeout: 2000 },
      () => {}
    );
    killToken.child = child;

    let buf = '';
    child.stdout && child.stdout.on('data', (d) => buf += String(d));
    child.stderr && child.stderr.on('data', (d) => buf += String(d));

    child.on('error', reject);
    child.on('close', () => {
      const out = String(buf).trim();
      const m = out.match(/free bytes\s*:\s*(\d+)/i);
      if (m) return resolve(Number(m[1]));
      reject(new Error('all methods failed'));
    });
  });
}

// ====== 主逻辑：现代/legacy 两条分支共用一套“轮询状态机” ======
export function activate(context: vscode.ExtensionContext) {
  let timer: NodeJS.Timeout | null = null;
  let inFlight = false;
  let lastSample: number | null = null;

  const killToken: { child?: ChildProcess | null; sock?: net.Socket | null } = { child: null, sock: null };

  function clearTimer() { if (timer) { clearTimeout(timer); timer = null; } }
  function hardStopInFlight() {
    try { if (killToken.child && !killToken.child.killed) killToken.child.kill(); } catch {}
    try { if (killToken.sock) killToken.sock.destroy(); } catch {}
    killToken.child = null;
    killToken.sock = null;
  }

  // ---- 现代 webviewPanel 分支 ----
  let panel: vscode.WebviewPanel | null = null;
  let panelVisible = false;
  let webviewVisible = false;

  // ---- legacy previewHtml 分支 ----
  let legacyProvider: vscode.TextDocumentContentProvider | null = null;
  let legacyEmitter: vscode.EventEmitter<vscode.Uri> | null = null;
  let legacyUri: vscode.Uri | null = null;
  let legacyHtmlText = getLegacyHtml('C: --', '...');

  function isRemoteOrNotWindows(): string | null {
    if (vscode.env.remoteName) return 'Remote 环境，已停止轮询';
    if (os.platform() !== 'win32') return '非 Windows，已停止轮询';
    return null;
  }

  function schedule(ms: number, runner: () => void) {
    clearTimer();
    timer = setTimeout(runner, ms);
  }

  function needUiUpdate(nextFree: number): boolean {
    if (lastSample === null) return true;
    return Math.abs(nextFree - lastSample) >= THRESHOLD_BYTES;
  }

  async function queryFreeBytes(): Promise<number> {
    const drive = getSystemDriveLetter();

    // daemon 优先
    try {
      return await queryFromDaemonPipe(drive, 500, killToken);
    } catch {
      // fallback exec
      return await queryByExecWindows(drive, killToken);
    }
  }

  function modernIsActuallyVisible(): boolean {
    return !!panel && panelVisible && webviewVisible;
  }

  function legacyIsActuallyVisible(): boolean {
    if (!legacyUri) return false;

    // 关键：visibleTextEditors 能满足“q2 在另一分组可见但不聚焦也算可见”
    const editors = vscode.window.visibleTextEditors || [];
    for (let i = 0; i < editors.length; i++) {
      const u = editors[i].document && editors[i].document.uri;
      if (u && u.toString() === legacyUri.toString()) return true;
    }
    return false;
  }

  // ====== 现代轮询循环（执行完再 setTimeout） ======
  async function modernLoopOnce() {
    if (!panel) return;
    if (!modernIsActuallyVisible()) { clearTimer(); hardStopInFlight(); return; }
    if (inFlight) return;
    inFlight = true;

    try {
      const stopReason = isRemoteOrNotWindows();
      if (stopReason) {
        clearTimer(); hardStopInFlight();
        panel.webview.postMessage({ type: 'disk', text: 'C: N/A', sub: stopReason });
        return;
      }

      const free = await queryFreeBytes();

      const upd = needUiUpdate(free);
      lastSample = free;

      if (upd && panel) {
        const drive = getSystemDriveLetter();
        panel.webview.postMessage({
          type: 'disk',
          text: `${drive}: ${fmtGB(free)} GB`,
          sub: `delta>=11MB 才更新；下次请求：${pickIntervalMs(free)}ms`
        });
      }

      schedule(pickIntervalMs(free), modernLoopOnce);
    } catch (e: any) {
      if (panel) panel.webview.postMessage({ type: 'disk', text: 'C: --', sub: '读取失败：' + (e && e.message ? e.message : String(e)) });
      schedule(INTERVAL_HIGH_MS, modernLoopOnce);
    } finally {
      inFlight = false;
      killToken.child = null;
      killToken.sock = null;
    }
  }

  function modernRefreshRunState() {
    if (modernIsActuallyVisible()) schedule(0, modernLoopOnce);
    else { clearTimer(); hardStopInFlight(); }
  }

  // ====== legacy 轮询循环 ======
  async function legacyLoopOnce() {
    if (!legacyUri || !legacyEmitter) return;
    if (!legacyIsActuallyVisible()) { clearTimer(); hardStopInFlight(); return; }
    if (inFlight) return;
    inFlight = true;

    try {
      const stopReason = isRemoteOrNotWindows();
      if (stopReason) {
        clearTimer(); hardStopInFlight();
        legacyHtmlText = getLegacyHtml('C: N/A', stopReason);
        legacyEmitter.fire(legacyUri);
        return;
      }

      const free = await queryFreeBytes();
      const upd = needUiUpdate(free);
      lastSample = free;

      if (upd) {
        const drive = getSystemDriveLetter();
        legacyHtmlText = getLegacyHtml(`${drive}: ${fmtGB(free)} GB`, `delta>=11MB 才更新；下次请求：${pickIntervalMs(free)}ms`);
        legacyEmitter.fire(legacyUri); // 触发 previewHtml 刷新
      }

      schedule(pickIntervalMs(free), legacyLoopOnce);
    } catch (e: any) {
      legacyHtmlText = getLegacyHtml('C: --', '读取失败：' + (e && e.message ? e.message : String(e)));
      legacyEmitter.fire(legacyUri);
      schedule(INTERVAL_HIGH_MS, legacyLoopOnce);
    } finally {
      inFlight = false;
      killToken.child = null;
      killToken.sock = null;
    }
  }

  function legacyRefreshRunState() {
    if (legacyIsActuallyVisible()) schedule(0, legacyLoopOnce);
    else { clearTimer(); hardStopInFlight(); }
  }

  // 监听“可见编辑器变化”，用于 legacy 精确判断隐藏/显示
  context.subscriptions.push(vscode.window.onDidChangeVisibleTextEditors(() => {
    if (legacyUri) legacyRefreshRunState();
  }));

  // ====== 打开 q2 ======
  context.subscriptions.push(
    vscode.commands.registerCommand('q2.open', async () => {
      // 优先现代 createWebviewPanel（>=1.23 stable）:contentReference[oaicite:2]{index=2}
      const canModern = !!(vscode.window as any).createWebviewPanel;

      if (canModern) {
        if (panel) {
          panel.reveal(panel.viewColumn || vscode.ViewColumn.One, true);
          modernRefreshRunState();
          return;
        }

        panel = (vscode.window as any).createWebviewPanel(
          'q2',
          'q2',
          { viewColumn: vscode.ViewColumn.One, preserveFocus: true },
          { enableScripts: true, retainContextWhenHidden: true }
        ) as vscode.WebviewPanel;

        panel.webview.html = getModernWebviewHtml();

        panelVisible = panel.visible;
        webviewVisible = true;

        panel.onDidDispose(() => {
          clearTimer(); hardStopInFlight();
          panel = null;
        });

        panel.onDidChangeViewState((e) => {
          panelVisible = e.webviewPanel.visible;
          modernRefreshRunState();
        });

        panel.webview.onDidReceiveMessage((msg: any) => {
          if (msg && msg.type === 'q2Vis') {
            webviewVisible = !!msg.visible;
            modernRefreshRunState();
          }
        });

        modernRefreshRunState();
        return;
      }

      // ===== legacy：previewHtml（<=1.22/更早） =====
      // 注意：previewHtml 后来被弃用:contentReference[oaicite:3]{index=3}，但你要兼容老版本只能这么干
      if (!legacyEmitter) legacyEmitter = new vscode.EventEmitter<vscode.Uri>();
      if (!legacyProvider) {
        legacyProvider = {
          onDidChange: legacyEmitter.event,
          provideTextDocumentContent: () => legacyHtmlText
        };
        context.subscriptions.push(vscode.workspace.registerTextDocumentContentProvider(LEGACY_SCHEME, legacyProvider));
      }
      legacyUri = vscode.Uri.parse(`${LEGACY_SCHEME}:/${LEGACY_PATH}`);

      await vscode.commands.executeCommand('vscode.previewHtml', legacyUri, vscode.ViewColumn.One, 'q2');

      legacyRefreshRunState();
    })
  );
}

export function deactivate() {}