# 6. Node/TS 端参考代码（可直接抄）

下面这段代码涵盖：

* 找 cache dir
* 读 endpoint/token
* 连接 socket/pipe（`net.connect({path})` 一把梭：Windows pipe 也用 path）
* JSONL 编解码
* 请求-响应匹配（基于 `_id`）
* spawn + 重试 + 心跳 + 自动重连

> 你放在 `src/brokerClient.ts` 之类即可。

```ts
import * as vscode from "vscode";
import * as net from "net";
import * as fs from "fs";
import * as path from "path";
import { spawn } from "child_process";
import { randomUUID } from "crypto";

type EndpointInfo =
  | { family: "pipe"; pipe: string; app_id: string; protocol: number; pid?: number; token_enabled?: boolean }
  | { family: "unix"; path: string; app_id: string; protocol: number; pid?: number; token_enabled?: boolean };

type Pending = {
  resolve: (v: any) => void;
  reject: (e: any) => void;
  timer: NodeJS.Timeout;
};

function getCacheDir(): string {
  if (process.platform === "win32") {
    return path.join(process.env.LOCALAPPDATA || process.env.APPDATA || process.env.TEMP || ".", "vix_audio_broker");
  }
  return path.join(process.env.XDG_CACHE_HOME || path.join(process.env.HOME || ".", ".cache"), "vix_audio_broker");
}

function readJsonFile<T>(p: string): T | null {
  try {
    const s = fs.readFileSync(p, "utf8");
    return JSON.parse(s) as T;
  } catch {
    return null;
  }
}

function readTextFile(p: string): string | null {
  try {
    return fs.readFileSync(p, "utf8").trim();
  } catch {
    return null;
  }
}

export class BrokerClient {
  private socket: net.Socket | null = null;
  private connected = false;

  private readonly clientId = randomUUID();
  private token: string = "";
  private endpoint: EndpointInfo | null = null;

  private lineBuf = "";
  private nextId = 1;
  private pending = new Map<number, Pending>();

  private hbTimer: NodeJS.Timeout | null = null;

  // spawn 防抖（每窗口）
  private lastSpawnAt = 0;
  private spawning: Promise<void> | null = null;

  constructor(
    private readonly context: vscode.ExtensionContext,
    private readonly pythonExe: string,           // 你用的 python 路径
    private readonly brokerScriptPath: string,    // vix_broker_singleton.py
    private readonly implScriptPath: string       // 你的大脚本（包含 _dispatch_action）
  ) {}

  dispose() {
    this.stopHeartbeat();
    this.closeSocket();
  }

  // ---------- public API ----------
  async ensureConnected(): Promise<void> {
    if (this.connected && this.socket) return;

    // 先尝试连接现有 broker
    if (await this.tryConnectOnce()) return;

    // 连接不上就 spawn（节流+并发合并）
    await this.spawnBrokerThrottled();

    // spawn 后重试连接（带退避）
    const maxTry = 30;
    for (let i = 0; i < maxTry; i++) {
      await this.sleep(120 + i * 30);
      if (await this.tryConnectOnce()) return;
    }

    throw new Error("Broker connect failed after spawn+retries. Check python/script paths, endpoint/token files, or permissions.");
  }

  startHeartbeat(intervalMs = 20000) {
    if (this.hbTimer) return;
    this.hbTimer = setInterval(async () => {
      try {
        // 如果断了，会自动重连并续租
        await this.ensureConnected();
        await this.call("ping", {});
      } catch {
        // 静默：下一轮继续自愈
      }
    }, intervalMs);
  }

  stopHeartbeat() {
    if (this.hbTimer) clearInterval(this.hbTimer);
    this.hbTimer = null;
  }

  async call(action: string, payload: Record<string, any>, timeoutMs = 5000): Promise<any> {
    await this.ensureConnected();
    const id = this.nextId++;

    const req = {
      _id: id,
      action,
      client_id: this.clientId,
      token: this.token,
      ...payload,
    };

    const line = JSON.stringify(req) + "\n";

    return new Promise((resolve, reject) => {
      const timer = setTimeout(() => {
        this.pending.delete(id);
        reject(new Error(`RPC timeout: ${action}`));
      }, timeoutMs);

      this.pending.set(id, { resolve, reject, timer });

      try {
        this.socket!.write(line, "utf8");
      } catch (e) {
        clearTimeout(timer);
        this.pending.delete(id);
        reject(e);
      }
    });
  }

  // ---------- internal ----------
  private async tryConnectOnce(): Promise<boolean> {
    const cache = getCacheDir();
    const endpointPath = path.join(cache, "endpoint.json");
    const tokenPath = path.join(cache, "token.txt");

    const endpoint = readJsonFile<EndpointInfo>(endpointPath);
    const token = readTextFile(tokenPath);

    if (!endpoint || !token) return false;
    if (endpoint.app_id !== "vix-broker") return false;

    // 统一用 net.connect({path})：
    // - unix: endpoint.path
    // - windows named pipe: endpoint.pipe 形如 \\.\pipe\xxx
    const connPath = endpoint.family === "unix" ? endpoint.path : endpoint.pipe;
    if (!connPath) return false;

    // 尝试建立 socket
    const ok = await new Promise<boolean>((resolve) => {
      const s = net.connect({ path: connPath });

      const onError = () => {
        try { s.destroy(); } catch {}
        resolve(false);
      };

      s.once("error", onError);
      s.once("connect", () => resolve(true));
    });

    if (!ok) return false;

    // 真正建立连接并挂上监听（需要新建一次 socket，避免上面那次被 resolve 后丢引用）
    return await this.openAndHello(connPath, token, endpoint);
  }

  private async openAndHello(connPath: string, token: string, endpoint: EndpointInfo): Promise<boolean> {
    this.closeSocket();

    const s = net.connect({ path: connPath });
    this.socket = s;
    this.token = token;
    this.endpoint = endpoint;

    s.setKeepAlive(true);

    s.on("data", (buf) => this.onData(buf));
    s.on("error", () => this.onDisconnected());
    s.on("close", () => this.onDisconnected());

    const connected = await new Promise<boolean>((resolve) => {
      s.once("connect", () => resolve(true));
      s.once("error", () => resolve(false));
    });
    if (!connected) return false;

    // hello 校验
    try {
      const res = await this.call("hello", {}, 2000);
      if (!res || res.ok !== true || res.app_id !== "vix-broker") {
        this.closeSocket();
        return false;
      }
      this.connected = true;
      return true;
    } catch {
      this.closeSocket();
      return false;
    }
  }

  private onData(buf: Buffer) {
    this.lineBuf += buf.toString("utf8");
    while (true) {
      const idx = this.lineBuf.indexOf("\n");
      if (idx < 0) break;
      const line = this.lineBuf.slice(0, idx).trim();
      this.lineBuf = this.lineBuf.slice(idx + 1);
      if (!line) continue;

      let obj: any;
      try {
        obj = JSON.parse(line);
      } catch {
        continue;
      }

      const id = obj?._id;
      if (typeof id === "number" && this.pending.has(id)) {
        const p = this.pending.get(id)!;
        clearTimeout(p.timer);
        this.pending.delete(id);
        if (obj.ok === false) p.reject(new Error(obj.error || "rpc_error"));
        else p.resolve(obj);
      }
      // 这里也可以处理 broker 主动推送事件（如果你以后要做 server push）
    }
  }

  private onDisconnected() {
    if (!this.connected && !this.socket) return;
    this.connected = false;

    // reject 所有 pending
    for (const [id, p] of this.pending.entries()) {
      clearTimeout(p.timer);
      p.reject(new Error("disconnected"));
      this.pending.delete(id);
    }

    this.closeSocket();
  }

  private closeSocket() {
    const s = this.socket;
    this.socket = null;
    this.connected = false;
    this.lineBuf = "";
    if (s) {
      try { s.removeAllListeners(); } catch {}
      try { s.destroy(); } catch {}
    }
  }

  private async spawnBrokerThrottled(): Promise<void> {
    const now = Date.now();
    if (this.spawning) return this.spawning;

    // 3 秒内只 spawn 一次（每窗口）
    if (now - this.lastSpawnAt < 3000) return;

    this.lastSpawnAt = now;
    this.spawning = new Promise<void>((resolve) => {
      const args = [
        this.brokerScriptPath,
        "--impl",
        this.implScriptPath,
        "--broker",
      ];

      const child = spawn(this.pythonExe, args, {
        detached: true,
        stdio: "ignore",
        windowsHide: true,
      });

      child.unref();
      resolve();
    }).finally(() => {
      this.spawning = null;
    });

    return this.spawning;
  }

  private sleep(ms: number) {
    return new Promise((r) => setTimeout(r, ms));
  }
}
```

