## A) 先改 package.json（给你一份可直接替换的 scripts + devDependencies）

把你现在的 `scripts` 改成下面这样（保留你原来那几个也行，但 CI 我建议用 `ci:*` 这套，避免误 bump 版本）：

```json
{
  "scripts": {
    "ci:test": "vscode-test --config .vscode-test.js",
    "ci:package": "node -e \"require('fs').mkdirSync('dist',{recursive:true})\" && npx @vscode/vsce package --allow-missing-repository --allow-star-activation -o dist/qqq-${npm_package_version}.vsix",
    "ci:publish": "npx @vscode/vsce publish --allow-star-activation",

    "package": "npx @vscode/vsce package --allow-missing-repository --allow-star-activation",
    "publish": "npx @vscode/vsce publish --allow-star-activation",

    "test": "npm run ci:test"
  },
  "devDependencies": {
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.70.0",
    "@vscode/vsce": "^3.6.2",
    "@vscode/test-cli": "^0.0.0",
    "@vscode/test-electron": "^2.0.0",
    "mocha": "^10.0.0"
  }
}
```

