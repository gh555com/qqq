## 2) 终极版：ConfigGate（可直接替换你 global.js 里 ConfigManager 那段）

你现在的 ConfigManager 在 global.js 这段（读 DB → 读 workspace → default），我建议整体替换为下面这一套（“终极版”）：

> 目标：
>
> * VIP：读/写 DB（globalState），必要时可迁移 settings 的值；
> * 非 VIP：**只读 DEFAULT + session overrides**；
> * 非 VIP 改 settings：立刻生效（进 session），但自动清掉 settings.json 里对应项（可选强回弹，最稳）。

```js
// ===================== VIP / Trial ConfigGate (ULTIMATE) =====================
let _isVip = false;
let _sessionOverrides = Object.create(null);
let _suppressConfigEcho = 0; // 防止“我们自己回弹 settings”触发死循环
let _trialHintShown = false;

function setVipMode(v) {
  _isVip = !!v;
  _sessionOverrides = Object.create(null); // 模式切换时清会话覆写，防串味
}
function isVip() { return _isVip; }

// 你现在 DB key 是 `cfg_${key} `（尾部有空格）:contentReference[oaicite:7]{index=7}
// 终极版：同时兼容旧key+新key，写入时统一写“无尾空格”，并删除旧key（一次性净化）
function _dbKeys(key) {
  const a = `cfg_${key}`;     // 新
  const b = `cfg_${key} `;    // 旧（你现在用的）
  return [a, b];
}

async function _dbGet(key) {
  if (!extensionContext) return undefined;
  const [kNew, kOld] = _dbKeys(key);
  let v = extensionContext.globalState.get(kNew);
  if (v !== undefined) return v;
  v = extensionContext.globalState.get(kOld);
  if (v !== undefined) {
    // 迁移：读到旧key就搬到新key并清旧key（不影响体验）
    try {
      await extensionContext.globalState.update(kNew, v);
      await extensionContext.globalState.update(kOld, undefined);
    } catch {}
    return v;
  }
  return undefined;
}

async function _dbSet(key, value) {
  if (!extensionContext) return;
  const [kNew, kOld] = _dbKeys(key);
  await extensionContext.globalState.update(kNew, value);
  await extensionContext.globalState.update(kOld, undefined); // 清旧
}

// 强回弹：把 settings.json 里的 qqq.xxx 删除（Global/Workspace/WorkspaceFolder 都清）
async function _clearVscodeSettingEverywhere(key) {
  _suppressConfigEcho++;
  try {
    // Global + Workspace
    const cfg = vscode.workspace.getConfiguration("qqq");
    const ins = cfg.inspect(key);
    if (ins?.globalValue !== undefined) {
      await cfg.update(key, undefined, vscode.ConfigurationTarget.Global);
    }
    if (ins?.workspaceValue !== undefined) {
      await cfg.update(key, undefined, vscode.ConfigurationTarget.Workspace);
    }

    // WorkspaceFolder（每个 folder 单独清）
    const folders = vscode.workspace.workspaceFolders || [];
    for (const wf of folders) {
      const folderCfg = vscode.workspace.getConfiguration("qqq", wf.uri);
      const fin = folderCfg.inspect(key);
      if (fin?.workspaceFolderValue !== undefined) {
        await folderCfg.update(key, undefined, vscode.ConfigurationTarget.WorkspaceFolder);
      }
    }
  } finally {
    _suppressConfigEcho--;
  }
}

// 终极真理源：get
const ConfigManager = {
  get(key) {
    // 1) session overrides 永远优先（VIP/非VIP都可以用作“即时覆盖”）
    if (Object.prototype.hasOwnProperty.call(_sessionOverrides, key)) {
      return _sessionOverrides[key];
    }

    // 2) 非 VIP：彻底不读任何落盘（DB / settings.json 一律当不存在）
    if (!_isVip) return DEFAULT_CONFIG[key];

    // 3) VIP：读 DB；没有再“迁移式”读取 settings UI（可保留你现有逻辑）
    // 注意：这里是 sync get，所以用缓存/同步读；dbGet 是 async，最简单是保持你原先同步 globalState.get
    // 如果你想严格：把 dbGet 的 async 迁移去 init 阶段做一次“预加载到内存”。
    if (extensionContext) {
      // 兼容旧尾空格 key 的同步读（迁移放到 init 做）
      const v1 = extensionContext.globalState.get(`cfg_${key}`);
      if (v1 !== undefined) return v1;
      const v2 = extensionContext.globalState.get(`cfg_${key} `);
      if (v2 !== undefined) return v2;
    }

    try {
      const wsVal = vscode.workspace.getConfiguration("qqq").get(key);
      if (wsVal !== undefined) return wsVal;
    } catch {}

    return DEFAULT_CONFIG[key];
  },

  // 终极 set：VIP 可持久；非 VIP 只能 session
  async set(key, value, { persist = true } = {}) {
    _sessionOverrides[key] = value;

    if (_configChangeCallback) _configChangeCallback(key, value);

    if (!_isVip || !persist) {
      // 非VIP：绝不写DB；并且可选“强回弹”清掉 settings.json 的痕迹（最稳）
      if (!_trialHintShown) {
        _trialHintShown = true;
        try { vscode.window.showInformationMessage("试用模式：设置仅本次有效，重启后恢复默认。"); } catch {}
      }
      await _clearVscodeSettingEverywhere(key); // 这句就是“最稳固/最防篡改”的关键
      return;
    }

    // VIP：写 DB（globalState）
    await _dbSet(key, value);
  },

  getAll() {
    const res = {};
    for (const k of Object.keys(DEFAULT_CONFIG)) res[k] = this.get(k);
    return res;
  },

  onChange(cb) { _configChangeCallback = cb; },

  // 非VIP启动时：清一次所有 qqq.* setting，确保“重启一切还原”
  async nonVipBootstrapResetAll() {
    if (_isVip) return;
    for (const k of Object.keys(DEFAULT_CONFIG)) {
      await _clearVscodeSettingEverywhere(k);
    }
    // 注意：sessionOverrides 不清，允许你“启动后立刻通过命令设置一遍”也可
  },

  // VS Code 设置变更入口（唯一入口）
  async handleVscodeConfigChanged(event) {
    if (_suppressConfigEcho) return;

    // 只处理 qqq.* 这 19 个 key（你现在就是从 DEFAULT_CONFIG key 集合遍历）:contentReference[oaicite:8]{index=8}
    for (const key of Object.keys(DEFAULT_CONFIG)) {
      const fullKey = `qqq.${key}`;
      if (!event.affectsConfiguration(fullKey)) continue;

      const val = vscode.workspace.getConfiguration("qqq").get(key);
      const cur = this.get(key);
      if (val === cur) continue;

      // VIP：persist；非VIP：session + 回弹清除
      await this.set(key, val, { persist: _isVip });
    }
  }
};

// ============================================================================
// 你原来就导出了 setConfig/getConfig :contentReference[oaicite:9]{index=9}
// 保留：但内部走“终极 set”
function getConfig(key) { return ConfigManager.get(key); }
async function setConfig(key, value) { await ConfigManager.set(key, value, { persist: _isVip }); }
```

> 这一套已经把“绕过保存”的路堵死：
>
> * 非 VIP 时：globalState 不写；settings.json 的改动会被回弹删掉；
> * 重启后：没有任何落盘值可读，天然回 DEFAULT；
> * 用户就算手改 settings.json：也只会触发一次事件，被你吞掉 + 回弹。

