
public class IconHelper {
    [StructLayout(LayoutKind.Sequential, CharSet = CharSet.Unicode)]
    public struct SHFILEINFO {
        public IntPtr hIcon;
        public int iIcon;
        public uint dwAttributes;
        [MarshalAs(UnmanagedType.ByValTStr, SizeConst = 260)]
        public string szDisplayName;
        [MarshalAs(UnmanagedType.ByValTStr, SizeConst = 80)]
        public string szTypeName;
    }

    [DllImport("shell32.dll", CharSet = CharSet.Unicode)]
    public static extern IntPtr SHGetFileInfo(string pszPath, uint dwFileAttributes, ref SHFILEINFO psfi, uint cbSizeFileInfo, uint uFlags);

    [DllImport("user32.dll", SetLastError = true)]
    public static extern bool DestroyIcon(IntPtr hIcon);

    public const uint SHGFI_ICON = 0x100;
    public const uint SHGFI_LARGEICON = 0x0;
    public const uint SHGFI_SMALLICON = 0x1;
    public const uint SHGFI_USEFILEATTRIBUTES = 0x10;

    // 解析.lnk快捷方式文件，获取目标路径
    private static string ResolveShortcut(string lnkPath) {
        Console.WriteLine("[IconHelper] ResolveShortcut called for lnkPath: " + lnkPath);

        // 检查文件是否存在
        if (!File.Exists(lnkPath)) {
            Console.WriteLine("[IconHelper] ERROR: File does not exist: " + lnkPath);

            // 尝试处理路径编码问题
            try {
                // 获取文件所在目录
                string directory = Path.GetDirectoryName(lnkPath);
                Console.WriteLine("[IconHelper] Directory: " + directory);

                if (directory != null && Directory.Exists(directory)) {
                    Console.WriteLine("[IconHelper] Directory exists, listing files...");
                    string[] files = Directory.GetFiles(directory);
                    Console.WriteLine("[IconHelper] Found " + files.Length + " files in directory:");

                    // 显示所有文件，便于调试
                    for (int i = 0; i < files.Length; i++) {
                        string fileName = Path.GetFileName(files[i]);
                        Console.WriteLine("[IconHelper] File " + (i+1) + ": " + fileName + " (full path: " + files[i] + ")");
                    }

                    // 尝试查找相似的文件名
                    string fileNameWithoutExt = Path.GetFileNameWithoutExtension(lnkPath);
                    Console.WriteLine("[IconHelper] Looking for similar files to: " + fileNameWithoutExt);

                    foreach (string file in files) {
                        if (file.EndsWith(".lnk", StringComparison.OrdinalIgnoreCase)) {
                            string candidateName = Path.GetFileNameWithoutExtension(file);
                            Console.WriteLine("[IconHelper] Candidate lnk file: " + candidateName);
                        }
                    }
                } else {
                    Console.WriteLine("[IconHelper] Directory does not exist or is null");
                }
            } catch (Exception ex) {
                Console.WriteLine("[IconHelper] Directory analysis failed: " + ex.Message);
            }

            return null;
        }

        Console.WriteLine("[IconHelper] File exists, proceeding with resolution...");

        // 方式1：使用Windows Script Host COM对象（最可靠的方式）
        try {
            Console.WriteLine("[IconHelper] Method 1: Using WScript.Shell COM object...");
            Type wshShellType = Type.GetTypeFromProgID("WScript.Shell");
            if (wshShellType == null) {
                Console.WriteLine("[IconHelper] Method 1: Failed to get WScript.Shell type");
                return null;
            }

            object wshShell = Activator.CreateInstance(wshShellType);
            if (wshShell == null) {
                Console.WriteLine("[IconHelper] Method 1: Failed to create WScript.Shell instance");
                return null;
            }

            // 创建快捷方式对象
            object shortcut = null;
            try {
                shortcut = wshShellType.InvokeMember(
                    "CreateShortcut",
                    BindingFlags.InvokeMethod,
                    null,
                    wshShell,
                    new object[] { lnkPath }
                );
                if (shortcut == null) {
                    Console.WriteLine("[IconHelper] Method 1: Failed to create shortcut object");
                    return null;
                }
            } catch (Exception ex) {
                Console.WriteLine("[IconHelper] Method 1: CreateShortcut exception: " + ex.Message);
                return null;
            }

            // 获取快捷方式的所有可能属性
            try {
                // 获取TargetPath
                string targetPath = shortcut.GetType().InvokeMember(
                    "TargetPath",
                    BindingFlags.GetProperty,
                    null,
                    shortcut,
                    null
                ) as string;
                Console.WriteLine("[IconHelper] Method 1: TargetPath = '" + (targetPath ?? "null") + "'");

                // 检查TargetPath是否有效
                if (!string.IsNullOrEmpty(targetPath)) {
                    // 去除可能的引号
                    targetPath = targetPath.Trim('"');
                    if (!string.IsNullOrEmpty(targetPath)) {
                        Console.WriteLine("[IconHelper] Method 1: Resolved target path: " + targetPath);
                        return targetPath;
                    }
                }

                // 获取Arguments
                string arguments = shortcut.GetType().InvokeMember(
                    "Arguments",
                    BindingFlags.GetProperty,
                    null,
                    shortcut,
                    null
                ) as string;
                Console.WriteLine("[IconHelper] Method 1: Arguments = '" + (arguments ?? "null") + "'");

                // 获取WorkingDirectory
                string workingDir = shortcut.GetType().InvokeMember(
                    "WorkingDirectory",
                    BindingFlags.GetProperty,
                    null,
                    shortcut,
                    null
                ) as string;
                Console.WriteLine("[IconHelper] Method 1: WorkingDirectory = '" + (workingDir ?? "null") + "'");

                // 获取Description
                string description = shortcut.GetType().InvokeMember(
                    "Description",
                    BindingFlags.GetProperty,
                    null,
                    shortcut,
                    null
                ) as string;
                Console.WriteLine("[IconHelper] Method 1: Description = '" + (description ?? "null") + "'");

                // 获取IconLocation
                string iconLocation = shortcut.GetType().InvokeMember(
                    "IconLocation",
                    BindingFlags.GetProperty,
                    null,
                    shortcut,
                    null
                ) as string;
                Console.WriteLine("[IconHelper] Method 1: IconLocation = '" + (iconLocation ?? "null") + "'");

                // 如果获取到了IconLocation，尝试从中提取目标路径
                if (!string.IsNullOrEmpty(iconLocation)) {
                    string[] iconParts = iconLocation.Split(',');
                    if (iconParts.Length > 0 && !string.IsNullOrEmpty(iconParts[0])) {
                        string iconPath = iconParts[0].Trim('"');
                        Console.WriteLine("[IconHelper] Method 1: Extracted icon path from IconLocation: " + iconPath);
                        // 检查提取的图标路径是否有效
                        if (File.Exists(iconPath)) {
                            Console.WriteLine("[IconHelper] Method 1: Icon path exists, using it as target: " + iconPath);
                            return iconPath;
                        }
                    }
                }

            } catch (Exception ex) {
                Console.WriteLine("[IconHelper] Method 1: Property access exception: " + ex.Message);
            }

            Console.WriteLine("[IconHelper] Method 1: Failed to get valid target path");
            return null;

        } catch (Exception ex) {
            Console.WriteLine("[IconHelper] Method 1: Exception: " + ex.Message);
        }

        // 方式2：使用Shell32.Shell对象
        try {
            Console.WriteLine("[IconHelper] Method 2: Using Shell32.Shell COM object...");
            Type shellType = Type.GetTypeFromProgID("Shell.Application");
            if (shellType == null) {
                Console.WriteLine("[IconHelper] Method 2: Failed to get Shell.Application type");
                return null;
            }

            object shell = Activator.CreateInstance(shellType);
            if (shell == null) {
                Console.WriteLine("[IconHelper] Method 2: Failed to create Shell.Application instance");
                return null;
            }

            // 解析路径
            object folder = shellType.InvokeMember(
                "NameSpace",
                BindingFlags.InvokeMethod,
                null,
                shell,
                new object[] { Path.GetDirectoryName(lnkPath) }
            );

            if (folder != null) {
                object folderItem = folder.GetType().InvokeMember(
                    "ParseName",
                    BindingFlags.InvokeMethod,
                    null,
                    folder,
                    new object[] { Path.GetFileName(lnkPath) }
                );

                if (folderItem != null) {
                    // 尝试获取目标路径
                    object linkTarget = folderItem.GetType().InvokeMember(
                        "GetLink",
                        BindingFlags.InvokeMethod,
                        null,
                        folderItem,
                        null
                    );

                    if (linkTarget != null) {
                        string targetPath = linkTarget.GetType().InvokeMember(
                            "Path",
                            BindingFlags.GetProperty,
                            null,
                            linkTarget,
                            null
                        ) as string;
                        Console.WriteLine("[IconHelper] Method 2: Target path = '" + (targetPath ?? "null") + "'");

                        if (!string.IsNullOrEmpty(targetPath)) {
                            targetPath = targetPath.Trim('"');
                            if (!string.IsNullOrEmpty(targetPath) && File.Exists(targetPath)) {
                                Console.WriteLine("[IconHelper] Method 2: Successfully resolved target path");
                                return targetPath;
                            }
                        }
                    }
                }
            }

            Console.WriteLine("[IconHelper] Method 2: Failed to resolve .lnk file");
        } catch (Exception ex) {
            Console.WriteLine("[IconHelper] Method 2: Exception: " + ex.Message);
        }

        // 方式3：直接解析.lnk文件的二进制结构（简单版本）
        try {
            Console.WriteLine("[IconHelper] Method 3: Using binary parsing...");
            byte[] content = File.ReadAllBytes(lnkPath);

            // .lnk文件的基本结构：
            // 1. 4字节魔术数字：00 00 00 00
            // 2. 4字节GUID：01 14 02 00 00 00 00 00 C0 00 00 00 00 00 00 46
            // 3. 接下来是各种字段...

            // 查找TargetPath字段的偏移量（简化版）
            // 这是一个非常简化的解析，只适用于标准的.lnk文件
            int offset = 0;
            while (offset < content.Length - 4) {
                // 查找"Target"字符串的UTF-16表示
                if (content[offset] == 0x54 && content[offset + 1] == 0x00 && // "T" in UTF-16
                    content[offset + 2] == 0x61 && content[offset + 3] == 0x00 && // "a"
                    content[offset + 4] == 0x72 && content[offset + 5] == 0x00 && // "r"
                    content[offset + 6] == 0x67 && content[offset + 7] == 0x00 && // "g"
                    content[offset + 8] == 0x65 && content[offset + 9] == 0x00 && // "e"
                    content[offset + 10] == 0x74 && content[offset + 11] == 0x00) { // "t"

                    // 跳过"Target"字符串和字段头部
                    offset += 12 + 24; // 12字节"Target" + 24字节字段头部

                    // 读取字符串长度（UTF-16，每个字符2字节）
                    int length = BitConverter.ToInt16(content, offset);
                    offset += 2;

                    if (offset + length * 2 <= content.Length) {
                        // 提取UTF-16字符串
                        string targetPath = Encoding.Unicode.GetString(content, offset, length * 2);
                        Console.WriteLine("[IconHelper] Method 3: Binary parsing found target path: '" + targetPath + "'");

                        if (!string.IsNullOrEmpty(targetPath) && File.Exists(targetPath)) {
                            Console.WriteLine("[IconHelper] Method 3: Successfully resolved target path");
                            return targetPath;
                        }
                        break;
                    }
                }
                offset++;
            }

            Console.WriteLine("[IconHelper] Method 3: Binary parsing failed to find valid target path");
        } catch (Exception ex) {
            Console.WriteLine("[IconHelper] Method 3: Exception: " + ex.Message);
        }

        Console.WriteLine("[IconHelper] All methods failed to resolve .lnk target path");
        return null;
    }

    public static string GetIconBase64(string path) {
        Console.WriteLine("[IconHelper] GetIconBase64 called for path: " + path);

        // 检查路径是否为空
        if (string.IsNullOrEmpty(path)) {
            Console.WriteLine("[IconHelper] ERROR: Path is null or empty");
            return null;
        }

        // 检查文件是否存在
        if (!File.Exists(path)) {
            Console.WriteLine("[IconHelper] WARNING: File does not exist: " + path);

            // 尝试处理路径编码问题
            try {
                // 获取文件所在目录
                string directory = Path.GetDirectoryName(path);
                Console.WriteLine("[IconHelper] Directory: " + directory);

                if (directory != null && Directory.Exists(directory)) {
                    Console.WriteLine("[IconHelper] Directory exists, listing files to check encoding...");
                    string[] files = Directory.GetFiles(directory);
                    Console.WriteLine("[IconHelper] Found " + files.Length + " files in directory:");

                    // 显示所有文件，便于调试
                    for (int i = 0; i < files.Length; i++) {
                        string fileName = Path.GetFileName(files[i]);
                        Console.WriteLine("[IconHelper] File " + (i+1) + ": " + fileName + " (full path: " + files[i] + ")");

                        // 检查是否有相似的文件名（可能是编码问题）
                        string lnkFileName = Path.GetFileName(path);
                        if (files[i].EndsWith(".lnk", StringComparison.OrdinalIgnoreCase) &&
                            fileName.IndexOf(lnkFileName.Replace("榛", "") , StringComparison.OrdinalIgnoreCase) >= 0) {
                            Console.WriteLine("[IconHelper] POSSIBLE ENCODING MISMATCH: Found similar file: " + fileName);
                        }
                    }

                    // 尝试直接使用目录下的.lnk文件
                    foreach (string file in files) {
                        if (file.EndsWith(".lnk", StringComparison.OrdinalIgnoreCase)) {
                            Console.WriteLine("[IconHelper] Trying alternative lnk file: " + file);
                            string altResult = GetIconBase64(file);
                            if (altResult != null) {
                                Console.WriteLine("[IconHelper] SUCCESS: Got icon using alternative lnk file");
                                return altResult;
                            }
                        }
                    }
                } else {
                    Console.WriteLine("[IconHelper] Directory does not exist or is null");
                }
            } catch (Exception ex) {
                Console.WriteLine("[IconHelper] Path processing error: " + ex.Message);
            }
        } else {
            Console.WriteLine("[IconHelper] File exists: " + path);
        }

        // 对于.lnk文件，尝试解析快捷方式目标
        if (path.EndsWith(".lnk", StringComparison.OrdinalIgnoreCase)) {
            Console.WriteLine("[IconHelper] Detected .lnk file, trying to resolve...");
            string targetPath = ResolveShortcut(path);
            if (!string.IsNullOrEmpty(targetPath)) {
                Console.WriteLine("[IconHelper] Successfully resolved .lnk target: " + targetPath);
                // 先尝试获取目标文件的图标
                Console.WriteLine("[IconHelper] Trying to get icon from target path...");
                string icon = GetIconBase64Internal(targetPath);
                if (icon != null) {
                    Console.WriteLine("[IconHelper] Successfully got icon from target path");
                    return icon;
                } else {
                    Console.WriteLine("[IconHelper] Failed to get icon from target path, falling back...");
                }
            } else {
                Console.WriteLine("[IconHelper] Failed to resolve .lnk target path");
            }
        }

        // 直接获取原文件的图标（如果是.lnk文件，这是备用方案）
        Console.WriteLine("[IconHelper] Getting icon from original path...");
        return GetIconBase64Internal(path);
    }

    private static string GetIconBase64Internal(string path) {
        SHFILEINFO shinfo = new SHFILEINFO();
        try {
            // SHGFI_LARGEICON is 32x32
            IntPtr res = SHGetFileInfo(path, 0, ref shinfo, (uint)Marshal.SizeOf(shinfo), SHGFI_ICON | SHGFI_LARGEICON);
            if (res == IntPtr.Zero || shinfo.hIcon == IntPtr.Zero) return null;

            using (Icon icon = Icon.FromHandle(shinfo.hIcon)) {
                using (Bitmap bitmap = icon.ToBitmap()) {
                    using (MemoryStream ms = new MemoryStream()) {
                        bitmap.Save(ms, ImageFormat.Png);
                        return Convert.ToBase64String(ms.ToArray());
                    }
                }
            }
        } catch {
            return null;
        } finally {
            if (shinfo.hIcon != IntPtr.Zero) {
                DestroyIcon(shinfo.hIcon);
            }
        }
    }
