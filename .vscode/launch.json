// File: .vscode/launch.json
{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "扩展qqq开发",
            "type": "extensionHost",
            "request": "launch",
            "runtimeExecutable": "${execPath}",
            "args": [
                "--extensionDevelopmentPath=${workspaceFolder}"
            ]
        },
        {
            "name": "qqq-ai 扩展开发",
            "type": "extensionHost",
            "request": "launch",
            "args": [
                "--extensionDevelopmentPath=${workspaceFolder}/ai"
            ],
            "outFiles": [
                "${workspaceFolder}/ai/dist/**/*.js"
            ],
            "preLaunchTask": "bundle qqq-ai"
        }
    ]
}