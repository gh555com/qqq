# File: .vscodeignore
# VSCode 扩展打包时忽略的文件

# 开发工具
.vscode/**
.vscode-test/**
.gitignore
.qoder/**
.git/**
.trae/**

# ★ 隐藏的 nls 文件（不应该存在）
.package.nls.*.json

# 防止套娃！忽略打包生成的安装包
*.vsix  <--- 加上这一行！！！

# 测试文件
test-config-fix.js
*.test.js
*.spec.js

# 原始备份文件
extension.js

# 日志文件
*.log

# 临时文件
*.tmp
*.bak
.DS_Store
Thumbs.db

# 编译输出
out/**
build-artifacts/**
build/**
target/**

# Bundling: 排除源码和依赖，保留 bundle 产物
src/**
!src/i18n/**
node_modules/**
!dist/qqq.js
!dist/kp.py
esbuild.config.js

# 平台二进制处理 - 排除根目录下的 .dll 和 .exe 文件
# assets/runtimes/ 中的 DLL 由 CI/CD workflow 按平台动态管理
assets/*.dll
assets/*.exe
assets/q_*

# 其他开发文件
.eslintrc.json
tsconfig.json

# 原始材料文件夹 - 减小包体积
res/

# 未使用的图片文件
assets/al.gif

# 文档和测试文件 (保留 expert_cookies.txt)
docs/*
!docs/expert_cookies.txt
test/
*.md

# CI/CD & Release Tools
**/workflows/**
.github/**
.release-please-manifest.json
release-please-config.json
git_help.js
version-manager/**

# Development & Test
.vscode-test.js
package-lock.json
CHANGELOG.md
test/**
docs/*
!docs/expert_cookies.txt
rust/**
.idea/**
.git/**
*.log
*.tmp
*.bak

# Root Temp Files
qq
时间参数提前
*.vsix
