# File: .vscodeignore
# VSCode 扩展打包时忽略的文件

# 开发工具
.vscode/**
.vscode-test/**
.gitignore
.qoder/**
.git/**
.trae/**
identities/**

# ★ 隐藏的 nls 文件（不应该存在）
.package.nls.*.json

# 防止套娃！忽略打包生成的安装包
*.vsix  <--- 加上这一行！！！

# 测试文件
test-config-fix.js
*.test.js
*.spec.js

# 原始备份文件
extension.js

# 日志文件
*.log

# 临时文件
*.tmp
*.bak
.DS_Store
Thumbs.db

# 编译打印
out/**
build-artifacts/**
artifacts/**
build/**
target/**

# Bundling: 排除源码和依赖，保留 bundle 产物
src/**
!src/i18n/**
node_modules/**
!dist/qqq.js
!dist/kp.py
esbuild.config.js

# ★ dist 构建产物/缓存/冗余文件
dist/*
dist/**/*
!dist/qqq.js
!dist/kp.py
!dist/miniaudio_v16.py

# 平台二进制处理
# 1. 排除 assets 根目录下的重复 DLL (运行时由 runtimes/x64 提供)
assets/concrt140.dll
assets/msvcp140.dll
assets/msvcp140_1.dll
assets/msvcp140_2.dll
assets/vccorlib140.dll
assets/vcruntime140.dll
assets/vcruntime140_1.dll
# ★ 不再支持 win32-ia32，排除 x86 DLL
assets/runtimes/x86/**
# 2. q_engine 平台二进制：4个全部打入 Universal 包（运行时按 platform+arch 选用）
# assets/q_win_x64.exe, assets/q_linux_x64, assets/q_mac_x64, assets/q_mac_arm64
# ★ 排除旧版遗留的 q_engine 通用名（不应存在，仅为保险）
assets/q_engine.exe
assets/q_engine
# 3. 排除备份文件
assets/*.bak

# 其他开发文件
.eslintrc.json
tsconfig.json

# 原始材料文件夹 - 减小包体积
res/

# 未使用的图片文件
assets/al.gif

# 文档和测试文件 (保留 expert_cookies.txt 和 CHANGELOG.md)
docs/*
!docs/expert_cookies.txt
test/
*.md
!CHANGELOG.md

# CI/CD & Release Tools
qqqworkflow/**
**/workflows/**
.github/**
.release-please-manifest.json
release-please-config.json
git_help.js
version-manager/**

# Development & Test
.vscode-test.js
package-lock.json
test/**
docs/*
!docs/expert_cookies.txt
rust/**
.idea/**
.git/**
*.log
*.tmp
*.bak

# Root Temp Files
qq
时间参数提前
*.vsix
13dll.py
chrome 版本检测.py
git_status.txt
q4-history-*.json
uninstall_packages.bat
*.json.bak
err.log
vscode-app-*.log
rep_*.md
DISPOSABLE_*.md
REPAIR_BLUEPRINT.md
qqq-wq-integration.md

# ★ 中文文件名 (OPC URI 规范不兼容中文/特殊字符)
qqq滴登录设计
微软事件总结. txt
时间参数提前
ignore/
open/
ai/
ide/
