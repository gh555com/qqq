# File: .vscodeignore
# VSCode 扩展打包时忽略的文件

# 开发工具
.vscode/**
.vscode-test/**
.gitignore
.qoder/**
.git/**
.trae/**


# 防止套娃！忽略打包生成的安装包
*.vsix  <--- 加上这一行！！！

# 测试文件
test-config-fix.js
*.test.js
*.spec.js

# 原始备份文件
extension.js

# 日志文件
*.log

# 临时文件
*.tmp
*.bak
.DS_Store
Thumbs.db

# 编译输出
out/**
dist/**

# 其他开发文件
.eslintrc.json
tsconfig.json
