# File: .vscodeignore
# VSCode 扩展打包时忽略的文件

# 开发工具
.vscode/**
.vscode-test/**
.gitignore
.qoder/**
.git/**
.trae/**


# 防止套娃！忽略打包生成的安装包
*.vsix  <--- 加上这一行！！！

# 测试文件
test-config-fix.js
*.test.js
*.spec.js

# 原始备份文件
extension.js

# 日志文件
*.log

# 临时文件
*.tmp
*.bak
.DS_Store
Thumbs.db

# 编译输出
out/**
dist/**

# 其他开发文件
.eslintrc.json
tsconfig.json

# 原始材料文件夹 - 减小包体积
res/

# 构建产物assets文件夹 - 在release阶段单独处理
assets/

# 未使用的图片文件
assets/al.gif

# 文档和测试文件
docs/
test/
*.md

# 开发工具文件
rust/
.idea/
.git/
*.log
*.tmp
*.bak

# 根目录临时文件
qq
时间参数提前
