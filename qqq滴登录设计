// rateLimit.ts
import * as vscode from 'vscode';
export class RateLimit {
private context: vscode.ExtensionContext;
constructor(context: vscode.ExtensionContext) {
this.context = context;
}
// 获取今天的日期字符串
private getToday(): string {
return new Date().toISOString().split('T')[0]; // "2025-06-28"
}
// 检查是否可以请求
async canRequest(): Promise<{ ok: boolean; reason?: string }> {
const today = this.getToday();
// 读取本地存储
const data = this.context.globalState.get<{
date: string;
count: number;
failCount: number;
blockedUntil: number;
}>('rateLimit') || { date: today, count: 0, failCount: 0, blockedUntil: 0 };
// 如果是新的一天，重置计数
if (data.date !== today) {
data.date = today;
data.count = 0;
data.failCount = 0;
data.blockedUntil = 0;
}
// 检查是否在冷却中
if (Date.now() < data.blockedUntil) {
const waitSeconds = Math.ceil((data.blockedUntil - Date.now()) / 1000);
return { ok: false, reason: `请等待 ${waitSeconds} 秒后重试` };
}
// 检查今日次数
if (data.count >= 10) {
return { ok: false, reason: '今日查询次数已用完，明天再试' };
}
return { ok: true };
}
// 记录一次请求
async recordRequest(success: boolean) {
const today = this.getToday();
const data = this.context.globalState.get<{
date: string;
count: number;
failCount: number;
blockedUntil: number;
}>('rateLimit') || { date: today, count: 0, failCount: 0, blockedUntil: 0 };
if (data.date !== today) {
data.date = today;
data.count = 0;
data.failCount = 0;
data.blockedUntil = 0;
}
data.count++;
if (success) {
// 成功了，重置失败计数
data.failCount = 0;
} else {
// 失败了
data.failCount++;
// 连续失败 3 次，冷却 5 分钟
if (data.failCount >= 3) {
data.blockedUntil = Date.now() + 5 * 60 * 1000;
data.failCount = 0; // 重置，下次冷却结束后重新计数
}
}
await this.context.globalState.update('rateLimit', data);
}
}
