// 频率限制数据
type RateLimitData struct {
Count     int
ResetTime time.Time
}
var (
// IP 限制：每分钟 5 次
ipLimits = make(map[string]*RateLimitData)
ipMutex  sync.RWMutex
// 手机号限制：每天 20 次
phoneLimits = make(map[string]*RateLimitData)
phoneMutex  sync.RWMutex
)
// 检查 IP 限制
func checkIPLimit(ip string) bool {
ipMutex.Lock()
defer ipMutex.Unlock()
now := time.Now()
data, exists := ipLimits[ip]
if !exists || now.After(data.ResetTime) {
// 新的或已过期，重置
ipLimits[ip] = &RateLimitData{
Count:     1,
ResetTime: now.Add(1 * time.Minute),
}
return true
}
if data.Count >= 5 {
return false // 超限
}
data.Count++
return true
}
// 检查手机号限制
func checkPhoneLimit(phone string) bool {
phoneMutex.Lock()
defer phoneMutex.Unlock()
now := time.Now()
today := time.Date(now.Year(), now.Month(), now.Day(), 0, 0, 0, 0, now.Location())
tomorrow := today.Add(24 * time.Hour)
data, exists := phoneLimits[phone]
if !exists || now.After(data.ResetTime) {
phoneLimits[phone] = &RateLimitData{
Count:     1,
ResetTime: tomorrow,
}
return true
}
if data.Count >= 20 {
return false
}
data.Count++
return true
}
