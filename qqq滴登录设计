try {
const response = await fetch(
`https://你的网站.com/api/check?session=${sessionId}`
);
const data = await response.json();
if (data.status === 'success') {
// 成功了！
await context.globalState.update('vipToken', data.token);
vscode.window.showInformationMessage('�� VIP 激活成功，水印已去除！');
return;
}
} catch (e) {
// 网络错误，继续等
}
// 等 2 秒
await new Promise(r => setTimeout(r, 2000));
}
});
});
// 检查是否 VIP
