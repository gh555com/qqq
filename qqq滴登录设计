// 优先用 URI Handler，降级用轮询
async function waitForAuth(sessionId: string): Promise<string> {
return new Promise((resolve) => {
// 设置 URI Handler 回调
const disposable = registerUriCallback(sessionId, (token) => {
clearInterval(pollTimer);
resolve(token);
});
// 同时启动轮询作为备用
const pollTimer = setInterval(async () => {
const token = await pollForToken(sessionId);
if (token) {
disposable.dispose();
clearInterval(pollTimer);
resolve(token);
}
}, 2000);
});
}
