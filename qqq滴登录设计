// 存储登录状态
var sessions = sync.Map{}
func main() {
// 登录页面
http.HandleFunc("/login", func(w http.ResponseWriter, r *http.Request) {
session := r.URL.Query().Get("session")
// 记住这个 session
sessions.Store(session, "waiting")
// 显示登录页面...
w.Write([]byte(`
<h1>登录</h1>
<form action="/do-login" method="POST">
<input type="hidden" name="session" value="` + session + `">
<input type="text" name="username" placeholder="用户名">
<input type="password" name="password" placeholder="密码">
<button type="submit">登录</button>
</form>
`))
})
// 处理登录
http.HandleFunc("/do-login", func(w http.ResponseWriter, r *http.Request) {
session := r.FormValue("session")
// ... 验证用户 ...
// 生成 VIP token
token := "vip_" + session
// 更新状态
sessions.Store(session, token)
w.Write([]byte("登录成功！请返回 VS Code"))
})
// VS Code 轮询这个接口
http.HandleFunc("/api/check", func(w http.ResponseWriter, r *http.Request) {
session := r.URL.Query().Get("session")
value, ok := sessions.Load(session)
if !ok {
w.Write([]byte(`{"status": "not_found"}`))
return
}
if value == "waiting" {
w.Write([]byte(`{"status": "waiting"}`))
} else {
w.Write([]byte(`{"status": "success", "token": "` + value.(string) + `"}`))
}
})
http.ListenAndServe(":8080", nil)
}
