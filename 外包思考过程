function wireVipConfigWatcher(context) {
  context.subscriptions.push(
    vscode.workspace.onDidChangeConfiguration(e => {
      if (!e.affectsConfiguration("qqq")) return;

      // VIP 锁默认时：你可以选择直接忽略，并弹一次提示
      if (isVipLocked()) {
        // 可选：提示“VIP模式开启：配置被锁为默认”
        return;
      }

      // 非 VIP：把所有你关心的 key 读出来，写入 sessionOverrides
      const cfg = vscode.workspace.getConfiguration("qqq");
      for (const k of Object.keys(DEFAULT_CONFIG)) {
        const v = cfg.get(k, DEFAULT_CONFIG[k]);
        _sessionOverrides.set(k, v);
      }

      // 立即应用：触发你现有的刷新/重启/重绘逻辑
      // 例如：invalidateEngineCache(); updateStatusBarNow(); 或你自己的 applySettings()
    })
  );
}
```

> 这样用户每次在 Settings UI 改动，你都能“立刻响应”。重启 VS Code 后 `_sessionOverrides` 清空，**效果自然还原**。

