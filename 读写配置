# file: main_app.py

import os
from ini_manager import IniSectionManager
import time

# --- 1. 基本设置 ---
# 定义我们共享的配置文件路径
# 注意：在 Windows 中，路径里的反斜杠 `\` 最好用 `r""` 或 `\\` 来表示，避免转义问题
CONFIG_FILE_PATH = r"E:\r\pz.ini"

# 假设这个程序负责管理名为 `[my_app_settings]` 的区域
MY_APP_SECTION_NAME = "my_app_settings"

# --- 2. 写入操作演示 ---
def save_my_settings():
    """演示如何写入配置。"""
    print(f"--- 准备写入 [{MY_APP_SECTION_NAME}] 区域 ---")

    # 实例化管理器，告诉它我们要操作哪个文件和哪个区域
    manager = IniSectionManager(CONFIG_FILE_PATH, MY_APP_SECTION_NAME)

    # 准备我们要写入的数据
    settings_to_save = {
        "user_name": "Gemini",
        "last_login": time.strftime("%Y-%m-%d %H:%M:%S"),
        "window_position": "300,450,800,600",
        "theme": "dark_mode"
    }
    print("要写入的数据:", settings_to_save)

    # 调用 write_section 方法，它会自动处理文件锁，保证安全
    manager.write_section(settings_to_save)

    print("写入操作完成！\n")


# --- 3. 读取操作演示 ---
def load_my_settings():
    """演示如何读取配置。"""
    print(f"--- 准备读取 [{MY_APP_SECTION_NAME}] 区域 ---")

    # 同样，先实例化管理器
    manager = IniSectionManager(CONFIG_FILE_PATH, MY_APP_SECTION_NAME)

    # 调用 read_section 方法
    # 这个操作是只读的，所以非常快
    read_settings = manager.read_section()

    if not read_settings:
        print("配置文件或区域不存在，无法读取到任何设置。")
    else:
        print("成功读取到以下设置:")
        for key, value in read_settings.items():
            print(f"  - {key}: {value}")

    print("读取操作完成！\n")


# --- 4. 模拟另一个程序写入另一个区域 ---
def simulate_another_app_saving():
    """模拟一个完全不同的程序写入它自己的配置区域。"""
    print("--- (模拟另一个程序) 准备写入 [video_converter] 区域 ---")

    # 这个程序也使用同一个管理器类，但管理不同的区域
    video_manager = IniSectionManager(CONFIG_FILE_PATH, "video_converter")

    video_settings = {
        "default_codec": "h265",
        "output_quality": "high"
    }
    print("要写入的数据:", video_settings)

    video_manager.write_section(video_settings)
    print("(模拟另一个程序) 写入完成！\n")


# --- 主程序执行流程 ---
if __name__ == "__main__":

    # 为了演示，先确保配置文件是空的
    if os.path.exists(CONFIG_FILE_PATH):
        os.remove(CONFIG_FILE_PATH)
        # 同时删除可能存在的锁文件
        if os.path.exists(CONFIG_FILE_PATH + ".lock"):
            os.remove(CONFIG_FILE_PATH + ".lock")

    # 第一次读取，文件不存在，应该返回空
    load_my_settings()

    # 第一次写入我们的程序配置
    save_my_settings()

    # 再读取一次，这次应该能读到数据了
    load_my_settings()

    # 模拟另一个程序也来写入这个配置文件
    simulate_another_app_saving()

    print(f"--- 所有操作完成，请检查文件 '{CONFIG_FILE_PATH}' 的内容。 ---")


