# file: ini_manager.py

import os
from typing import Dict, List
# 导入 filelock 库
from filelock import FileLock, Timeout

class IniSectionManager:
    """
    一个用于安全读写 INI 配置文件中特定区域（Section）的管理器 (v3.0 - 进程安全版)。

    核心特性:
    1.  **进程安全**：使用文件锁机制，确保多个程序或进程同时写入时不会发生数据冲突或丢失。
    2.  **格式保持**：完整保留文件原有的所有格式，包括首尾和内部的空行、注释等。
    3.  **智能定位**：新区域会被智能地添加到文件最后一个有效内容的后面。
    """

    def __init__(self, config_path: str, section_name: str, new_section_spacing: int = 2):
        self.config_path = config_path
        self.section_name = section_name
        self.section_header = f"[{self.section_name}]"
        self.new_section_spacing = new_section_spacing
        # 为配置文件创建一个对应的锁文件路径
        self.lock_path = f"{self.config_path}.lock"

    def read_section(self) -> Dict[str, str]:
        # 读取操作通常不需要加锁，因为它不会修改文件。
        # 但如果在读取时，另一个进程正在写入一个不完整的版本，可能会读到异常数据。
        # 为了绝对安全，也可以给读取加锁，但这会牺牲一些性能。
        # 在大多数场景下，读取不加锁是可接受的。
        if not os.path.exists(self.config_path):
            return {}
        # ... (读取逻辑和 v2.0 完全相同)
        data = {}
        in_section = False
        try:
            with open(self.config_path, 'r', encoding='utf-8') as f:
                for line in f:
                    line_strip = line.strip()
                    if line_strip.startswith('[') and line_strip.endswith(']'):
                        in_section = (line_strip == self.section_header)
                    elif in_section and '=' in line_strip:
                        if line_strip.startswith('#') or line_strip.startswith(';'):
                            continue
                        key, value = line_strip.split('=', 1)
                        data[key.strip()] = value.strip()
        except Exception as e:
            print(f"Error reading config file '{self.config_path}': {e}")
            return {}
        return data

    def write_section(self, data_to_write: Dict[str, str], timeout_seconds: int = 10):
        """
        将字典数据进程安全地写入指定区域。

        Args:
            data_to_write (Dict[str, str]): 要写入或更新的键值对字典。
            timeout_seconds (int): 获取文件锁的超时时间（秒）。
        """
        lock = FileLock(self.lock_path, timeout=timeout_seconds)

        try:
            # 核心改动：将整个“读取-修改-写入”操作放入 with lock.acquire() 块中
            with lock.acquire():
                # --- 从这里开始，代码和 v2.0 的写入逻辑完全一样 ---
                # --- 因为我们已经获得了锁，所以这部分操作是独占的、安全的 ---

                lines = []
                if os.path.exists(self.config_path):
                    try:
                        with open(self.config_path, 'r', encoding='utf-8') as f:
                            lines = f.readlines()
                    except Exception as e:
                        print(f"Could not read existing config file '{self.config_path}': {e}")
                        return

                new_lines: List[str] = []
                in_section = False
                section_found = False
                keys_to_write = set(data_to_write.keys())

                for line in lines:
                    line_strip = line.strip()
                    if line_strip == self.section_header:
                        in_section = True
                        section_found = True
                        new_lines.append(line)
                        for key in sorted(data_to_write.keys()):
                            new_lines.append(f"{key}={data_to_write[key]}\n")
                    elif line_strip.startswith('[') and line_strip.endswith(']'):
                        in_section = False
                        new_lines.append(line)
                    elif in_section:
                        is_key_value = '=' in line_strip and not (line_strip.startswith('#') or line_strip.startswith(';'))
                        if is_key_value:
                            key = line_strip.split('=', 1)[0].strip()
                            if key not in keys_to_write:
                                new_lines.append(line)
                        else:
                            new_lines.append(line)
                    else:
                        new_lines.append(line)

                if not section_found:
                    new_section_block = ['\n' * self.new_section_spacing]
                    new_section_block.append(f"{self.section_header}\n")
                    for key in sorted(data_to_write.keys()):
                        new_section_block.append(f"{key}={data_to_write[key]}\n")

                    insertion_index = -1
                    for i in range(len(lines) - 1, -1, -1):
                        if lines[i].strip():
                            insertion_index = i
                            break

                    final_lines = lines[:insertion_index + 1] + new_section_block + lines[insertion_index + 1:]
                    new_lines = final_lines

                config_dir = os.path.dirname(self.config_path)
                if config_dir and not os.path.exists(config_dir):
                    os.makedirs(config_dir, exist_ok=True)

                with open(self.config_path, 'w', encoding='utf-8') as f:
                    f.writelines(new_lines)

                # --- 操作结束，退出 with 块时，锁会自动释放 ---

        except Timeout:
            print(f"Error: Could not acquire lock on {self.config_path} after {timeout_seconds} seconds. Another process may be holding it.")
        except Exception as e:
            print(f"An unexpected error occurred during write: {e}")


