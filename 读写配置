# file: sqlite_manager.py

import sqlite3
import threading
from typing import Dict

class SQLiteConfigManager:
    """
    一个使用 SQLite 数据库来安全管理程序配置的管理器。

    核心设计哲学：
    1.  **进程/线程安全**：SQLite 默认在写入时会锁定整个数据库文件，这天然地防止了多个进程/线程同时写入时的数据损坏。
        我们额外使用线程锁（threading.Lock）来确保在多线程应用中，来自同一个进程的并发访问也是安全的。
    2.  **结构化存储**：数据被存储在一个结构化的表格中，每个程序（Section）的配置项被清晰地隔离开。
    3.  **原子性操作**：使用数据库的“事务”（Transaction）来执行写入，确保一批设置要么全部成功，要么全部失败，不会出现只写入一半的中间状态。
    4.  **接口统一**：提供与之前 IniSectionManager 类似的 `read_section` 和 `write_section` 接口，方便迁移和使用。
    """
    _locks = {}  # 类级别的字典，为每个数据库文件路径创建一个锁
    _lock_for_locks = threading.Lock() # 用于保护 _locks 字典本身的锁

    def __init__(self, db_path: str, section_name: str):
        """
        初始化管理器。

        Args:
            db_path (str): SQLite 数据库文件的路径。
            section_name (str): 本管理器实例负责的区域/程序名称。
        """
        self.db_path = db_path
        self.section_name = section_name

        # 为每个数据库文件创建一个唯一的锁，保证多线程安全
        with self._lock_for_locks:
            if self.db_path not in self._locks:
                self._locks[self.db_path] = threading.Lock()
        self.lock = self._locks[self.db_path]

        self._initialize_database()

    def _get_connection(self):
        """创建并返回一个数据库连接。"""
        # timeout 参数对于多进程/多线程至关重要，它指定了在放弃前等待锁定的时间（秒）
        return sqlite3.connect(self.db_path, timeout=10.0)

    def _initialize_database(self):
        """如果表不存在，则创建配置表。"""
        with self.lock:
            try:
                with self._get_connection() as conn:
                    cursor = conn.cursor()
                    # 表结构：section (程序名), key (配置键), value (配置值)
                    # PRIMARY KEY(section, key) 保证了每个程序下的配置键是唯一的
                    cursor.execute('''
                        CREATE TABLE IF NOT EXISTS config (
                            section TEXT NOT NULL,
                            key     TEXT NOT NULL,
                            value   TEXT,
                            PRIMARY KEY(section, key)
                        )
                    ''')
                    conn.commit()
            except sqlite3.Error as e:
                print(f"Database initialization error: {e}")

    def write_section(self, data_to_write: Dict[str, str]):
        """
        将一个字典的数据安全地写入到指定的区域。

        如果键已存在，则更新其值；如果不存在，则插入新行。
        整个操作在一个事务中完成，保证原子性。

        Args:
            data_to_write (Dict[str, str]): 要写入或更新的键值对字典。
        """
        with self.lock:
            try:
                with self._get_connection() as conn:
                    cursor = conn.cursor()
                    # 使用 INSERT OR REPLACE 语句，它会智能地处理插入或更新
                    # executemany 批量操作，性能更高
                    items_to_insert = [
                        (self.section_name, key, str(value))
                        for key, value in data_to_write.items()
                    ]
                    cursor.executemany('''
                        INSERT OR REPLACE INTO config (section, key, value)
                        VALUES (?, ?, ?)
                    ''', items_to_insert)
                    conn.commit()
            except sqlite3.Error as e:
                print(f"Error writing to database: {e}")

    def read_section(self) -> Dict[str, str]:
        """
        从数据库中读取指定区域的所有键值对。

        Returns:
            Dict[str, str]: 一个包含该区域所有键值对的字典。如果区域不存在，则返回空字典。
        """
        data = {}
        with self.lock:
            try:
                with self._get_connection() as conn:
                    cursor = conn.cursor()
                    cursor.execute(
                        "SELECT key, value FROM config WHERE section = ?",
                        (self.section_name,)
                    )
                    rows = cursor.fetchall()
                    data = dict(rows)
            except sqlite3.Error as e:
                print(f"Error reading from database: {e}")
        return data


介绍与使用示例
它是如何工作的？
这个管理器将所有配置都存放在一个 SQLite 数据库文件（例如 E:\r\config.db）里的一个名为 config 的表中。
表结构非常简单直观：
section (TEXT)	key (TEXT)	value (TEXT)
app_one	username	Alice
app_one	theme	dark
app_two	`codeccodec	h265
app_two	last_file	C:/video.mp4
●section 列：用来区分是哪个程序或模块的配置，相当于 INI 文件中的 [section_name]。
●`keykey 列：配置项的名称。
●value 列：配置项的值。
核心优势：
1.**内置内置并发控制：当一个程序执行写入操作时 ( INSERT, UPDATE )，SQLite 会自动锁定数据库文件，其他想写入的程序必须排队等待。这从根本上解决了 INI 文件方案中的“竞态条件”问题，不再需要外部的 .lock 文件。
2.原子性写入：write_section 方法中的所有操作都在一个“事务”中。这意味着，您传递的一整批设置要么全部成功写入，要么在发生错误时全部回滚，数据库不会处于一个只更新了一半的“脏”状态。
3.**性能：对于大量的配置项，SQLite 的查询和更新性能通常优于手动解析文本文件，因为它有索引等优化。

如何在程序中使用它？(示例)
假设您将上面的类保存为 sqlite_manager.py。下面是一个 main.py 演示两个不同程序如何共享同一个数据库文件来存取配置。

# file: main.py

import os
import time
from sqlite_manager import SQLiteConfigManager

# --- 1. 基本设置 ---
# 定义共享的 SQLite 数据库文件路径
DB_PATH = r"E:\r\config.db"

# --- 2. 模拟程序一 (视频转换器) ---
def run_video_converter():
    """模拟视频转换器读写配置。"""
    section_name = "video_converter"
    print(f"--- 视频转换器 [{section_name}] 正在运行 ---")

    # 实例化管理器
    manager = SQLiteConfigManager(DB_PATH, section_name)

    # 读取旧配置
    old_settings = manager.read_section()
    print("读取到的旧配置:", old_settings)

    # 准备新配置并写入
    new_settings = {
        "last_input_path": "E:/movies/project_x.mkv",
        "default_codec": "AV1",
        "quality_preset": "slow",
        "last_run_timestamp": time.time()
    }
    print("正在写入新配置:", new_settings)
    manager.write_section(new_settings)
    print("写入完成。\n")

# --- 3. 模拟程序二 (音频工具) ---
def run_audio_tool():
    """模拟音频工具读写配置。"""
    section_name = "audio_tool"
    print(f"--- 音频工具 [{section_name}] 正在运行 ---")

    # 实例化管理器，注意 section_name 不同
    manager = SQLiteConfigManager(DB_PATH, section_name)

    # 读取配置
    settings = manager.read_section()
    print("读取到的配置:", settings)

    # 写入配置
    settings_to_save = {
        "bitrate": "320k",
        "normalize": "true"
    }
    print("正在写入配置:", settings_to_save)
    manager.write_section(settings_to_save)
    print("写入完成。\n")


# --- 主程序执行流程 ---
if __name__ == "__main__":

    # 为了演示，先确保数据库文件是空的
    if os.path.exists(DB_PATH):
        os.remove(DB_PATH)

    print(f"所有程序将共享同一个数据库文件: '{DB_PATH}'\n")

    # 运行程序一
    run_video_converter()

    # 运行程序二
    run_audio_tool()

    # 再次运行程序一，这次它应该能读到上次保存的配置
    run_video_converter()

    print("--- 所有操作完成 ---")
    print("您可以使用 DB Browser for SQLite 之类的工具打开 E:\\r\\config.db 查看内容。")

运行这个示例后：
●您会看到控制台清晰地打印出每个“程序”读写自己配置的过程。
●在 E:\r\ 目录下会生成一个 config.db 文件。这个文件是一个二进制文件，您可以使用任何 SQLite 可视化工具（如免费的 https://sqlitebrowser.org/ ）打开它，会看到 config 表中整齐地存储着两个程序的所有配置数据。
