#### 1. 编码置信度（方案二有部分逻辑）

```javascript
// 方案二的 _scoreDecodedText - 给解码结果打分
function _scoreDecodedText(s) {
    let bad = 0, printable = 0, cjk = 0;

    for (let i = 0; i < s.length; i++) {
        const ch = s[i];
        if (ch === "\uFFFD") bad += 4;        // 替换字符扣分
        if (code === 0) bad += 6;              // NUL扣分
        if (code >= 0x20 && code !== 0x7f) printable++;
        if (code >= 0x4e00 && code <= 0x9fff) cjk += 3;  // CJK加分
    }
    return printable + cjk - bad;
}

// 方案二的 _decodeHtmlBytesSmart - 选择最佳编码
function _decodeHtmlBytesSmart(buf) {
    let candidates = [];
    candidates.push({ enc: "utf8", text: buf.toString("utf8") });
    candidates.push({ enc: "latin1", text: buf.toString("latin1") });
    // ... 可能加 utf16

    // 选分数最高的
    let best = "", bestScore = -1e18;
    for (const c of candidates) {
        const sc = _scoreDecodedText(c.text);  // ← 这里用了
        if (sc > bestScore) { bestScore = sc; best = c.text; }
    }
    return best;
}
```

**问题**：这个分数只用于**内部选择**编码，没有暴露给外部判断"是否足够好"。

