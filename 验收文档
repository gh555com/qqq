## 完整实现建议

```javascript
// ============== 新增：预检测函数 ==============

function _detectEncodingConfidence(buf) {
    // 尝试所有编码，返回最高分及其置信度
    const candidates = [
        { enc: "utf8", text: buf.toString("utf8") },
        { enc: "latin1", text: buf.toString("latin1") },
    ];

    // 检测 UTF-16
    const np = _looksLikeUtf16ByNullPattern(buf);
    if (np.ratioOdd > 0.08 || np.ratioEven > 0.08) {
        candidates.push({ enc: "utf16le", text: buf.toString("utf16le") });
    }

    let maxScore = -Infinity;
    for (const c of candidates) {
        const score = _scoreDecodedText(c.text);
        if (score > maxScore) maxScore = score;
    }

    // 归一化到 0~1
    // 经验值：好的文本 score/length ≈ 1.5~3，差的 < 0.5
    const normalized = maxScore / Math.max(1, buf.length);
    return Math.min(1, Math.max(0, normalized / 2));
}

function _checkHtmlIntegrity(htmlText) {
    if (!htmlText) return 0;

    // 检测损坏的标签
    const brokenCloseTags = (htmlText.match(/[\?\uFFFD]\/[a-z]{1,12}\s*>/gi) || []).length;
    const brokenOpenTags = (htmlText.match(/[\?\uFFFD][a-z]{1,12}[\s>]/gi) || []).length;
    const totalTags = (htmlText.match(/<\/?[a-z]{1,12}/gi) || []).length;

    if (totalTags === 0) return 0.5;  // 无标签，不确定

    const brokenRatio = (brokenCloseTags + brokenOpenTags) / totalTags;
    return Math.max(0, 1 - brokenRatio * 5);  // 放大惩罚
}

async function _checkPlainTextAlignment(htmlText) {
    const plainText = await vscode.env.clipboard.readText();
    if (!plainText || !htmlText) return false;

    // 从 HTML 提取几个锚点，检查纯文本是否包含
    const $ = cheerio.load(htmlText);
    const textContent = $.text().trim();

    // 取前中后三个锚点
    const anchors = [
        textContent.substring(0, 20),
        textContent.substring(Math.floor(textContent.length / 2), Math.floor(textContent.length / 2) + 20),
        textContent.substring(Math.max(0, textContent.length - 20)),
    ].map(s => s.replace(/\s+/g, ' ').trim()).filter(s => s.length > 5);

    let matchCount = 0;
    for (const anchor of anchors) {
        if (plainText.includes(anchor)) matchCount++;
    }

    return matchCount >= 2;  // 至少2个锚点匹配
}

// ============== 修改：智能方案选择 ==============

async function selectAndExecuteHtmlPaste(targetDir, partialCallback, token, progressCallback) {
    // 1. 获取原始数据（复用方案二的逻辑）
    let rawBuf = null;
    const res = await tryEngineCall({ python: "get_html", ... }, {}, 8000);
    if (res?.value_base64) {
        rawBuf = Buffer.from(res.value_base64, "base64");
    }

    if (!rawBuf) {
        // 直接用方案一
        return await handleClipboardNode(targetDir, partialCallback, token, progressCallback);
    }

    // 2. 预检测
    const sliced = _sliceCfHtmlPayload(rawBuf);
    const payload = sliced.fragBuf || sliced.htmlBuf;
    const htmlText = _decodeHtmlBytesSmart(payload);

    const encodingConf = _detectEncodingConfidence(payload);
    const htmlIntegrity = _checkHtmlIntegrity(htmlText);
    const plainTextOk = await _checkPlainTextAlignment(htmlText);

    global.logMessage(`[HTML方案选择] encoding=${encodingConf.toFixed(2)}, integrity=${htmlIntegrity.toFixed(2)}, plainTextOk=${plainTextOk}`, "DEBUG");

    // 3. 决策
    if (encodingConf > 0.7 && htmlIntegrity > 0.6) {
        // 方案二优先
        const r2 = await handleClipboardNodeScheme2(targetDir, partialCallback, token, progressCallback);
        if (r2 && _isResultQualityAcceptable(r2.blocks)) {
            return r2;
        }
        // 质量不行，回退
    }

    if (plainTextOk) {
        // 方案一
        return await handleClipboardNode(targetDir, partialCallback, token, progressCallback);
    }

    // 兜底：方案二（可能有乱码，但至少有结构）
    return await handleClipboardNodeScheme2(targetDir, partialCallback, token, progressCallback);
}

function _isResultQualityAcceptable(blocks) {
    if (!blocks || blocks.length === 0) return false;

    const allText = blocks
        .filter(b => b.type === "text")
        .map(b => b.text || "")
        .join("");

    if (allText.length === 0) return true;  // 纯图片，OK

    const badChars = (allText.match(/[\uFFFD]/g) || []).length;
    const questionMarks = (allText.match(/\?{3,}/g) || []).length;  // 连续问号

    const badRatio = badChars / allText.length;

    return badRatio < 0.05 && questionMarks < 3;
}
