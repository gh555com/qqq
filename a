        .scrollbar-inner-thumb:hover { opacity: 0.7; width: 6px; right: 0; }

        .footer { text-align: center; padding: 20px; font-size: 0.8em; opacity: 0.6; }
    </style>
</head>

<body>
    <div class="main-wrapper">
        <div class="main-content" id="mainContent">
            <!-- 音乐播放器 -->
