            <div class="section-title">Captain</div>
            <div class="captain-grid" id="captainGrid">
                <div class="cmd-btn" data-cmd="qqq.savorMoments"><span>✨</span> <span>savor moments for yourself</span></div>
                <div class="cmd-btn" data-cmd="qqq.q1"><span>📋</span> <span>Paste everything ("Ctrl+V" or "F2")</span></div>
                <div class="cmd-btn" data-cmd="qqq.q2"><span>🌍</span> <span>Roam everywhere ("Tab" or "F6")</span></div>
                <div class="cmd-btn" data-cmd="qqq.downloadVideosFromUrl"><span>🎥</span> <span>insert Videos From Url</span></div>
                <div class="cmd-btn" data-cmd="qqq.cleanUp"><span>🧹</span> <span>clean up</span></div>
                <div class="cmd-btn" data-cmd="qqq.exportDoc"><span>📄</span> <span>exportDoc</span></div>
                <div class="cmd-btn" data-cmd="qqq.pure"><span>💎</span> <span>Pure</span></div>
                <div class="cmd-btn" data-cmd="qqq.exportZip"><span>📦</span> <span>exportZip</span></div>
                <div class="cmd-btn" data-cmd="qqq.allSettings"><span>⚙️</span> <span>allSettings</span></div>
            </div>

            <div class="section-title">Passed by</div>
            <div class="history-container" id="historyContainer">
                <div class="history-list" id="historyList">
                    <div style="text-align:center;padding:20px;opacity:0.5;">加载中...</div>
                </div>
                <div class="scrollbar-inner" id="innerScrollbar"><div class="scrollbar-inner-thumb" id="innerThumb"></div></div>
            </div>

            <div style="display: flex; gap: 8px; margin-bottom: 20px;">
                <button class="action-mini-btn" style="flex: 1;" id="btnRefresh">🔄 刷新</button>
                <button class="action-mini-btn" style="flex: 1;" id="btnClear">🗑️ 清空</button>
            </div>

            <div class="section-title">Dial</div>
            <div class="stats-grid" id="dialGrid">
                <div class="stat-card">
                    <div class="stat-title">⏱️ 陪伴时间</div>
                    <div class="stat-value" id="statTime">0h 0m</div>
                </div>
                <div class="stat-card">
                    <div class="stat-title">💾 缓存量</div>
                    <div class="stat-value" id="statCache">0.0MB</div>
                </div>
                <div class="stat-card">
                    <div class="stat-title">🎯 命中率</div>
                    <div class="stat-value" id="statHit">0.0%</div>
                </div>
                <div class="stat-card">
                    <div class="stat-title">⚡ 引擎</div>
                    <div class="stat-value" id="statEngine">Node</div>
                </div>
                <div class="stat-card engine-card">
                    <div class="stat-title">ℹ️ 引擎详情</div>
                    <div class="stat-value" style="font-size: 0.85em;" id="statEngineDetails">-</div>
                </div>
            </div>

            <div class="footer">qqq 扩展 - 领航员面板</div>
        </div>

        <div class="scrollbar-outer" id="outerScrollbar"><div class="scrollbar-outer-thumb" id="outerThumb"></div></div>
    </div>

    <script nonce="${nonce}">
        (function(){
            'use strict';

            let vscodeApi = null;
            try { vscodeApi = acquireVsCodeApi(); } catch(e) {}

            function postMessage(msg){
                if(vscodeApi) vscodeApi.postMessage(msg);
            }

            const el = {
                mainContent: document.getElementById('mainContent'),
                historyList: document.getElementById('historyList'),
                captainGrid: document.getElementById('captainGrid'),
                btnRefresh: document.getElementById('btnRefresh'),
                btnClear: document.getElementById('btnClear'),

                btnMusicPlay: document.getElementById('btnMusicPlay'),
                btnMusicStop: document.getElementById('btnMusicStop'),
                musicStatus: document.getElementById('musicStatus'),

                statTime: document.getElementById('statTime'),
                statCache: document.getElementById('statCache'),
                statHit: document.getElementById('statHit'),
                statEngine: document.getElementById('statEngine'),
                statEngineDetails: document.getElementById('statEngineDetails'),

                outerScrollbar: document.getElementById('outerScrollbar'),
                outerThumb: document.getElementById('outerThumb'),
                innerScrollbar: document.getElementById('innerScrollbar'),
                innerThumb: document.getElementById('innerThumb'),
            };

            function escapeHtml(t){
                if(!t) return '';
                return String(t)
                    .replace(/&/g,'&amp;')
                    .replace(/</g,'&lt;')
                    .replace(/>/g,'&gt;')
                    .replace(/"/g,'&quot;')
                    .replace(/'/g,'&#039;');
            }

            let currentAudio = null;
            let audioBase64 = '';

            function stopMusic(){
                if(currentAudio){
                    try {
                        currentAudio.pause();
                        currentAudio.currentTime = 0;
                    } catch {}
                    currentAudio = null;
                }
                if(el.musicStatus){
                    el.musicStatus.innerText = 'Stopped';
                    el.musicStatus.classList.remove('music-playing');
                }
            }

            function playAudio(base64, times){
                try{
                    if(!base64) return;
                    stopMusic();

                    const audio = new Audio('data:audio/mp3;base64,' + base64);
                    currentAudio = audio;
                    audio.volume = 0.5;

                    if(el.musicStatus){
                        el.musicStatus.innerText = 'Savoring...';
                        el.musicStatus.classList.add('music-playing');
                    }

                    if(times === 0){
                        audio.loop = true;
                    } else {
                        let playCount = 1;
                        audio.addEventListener('ended', function(){
                            if(playCount < times){
                                playCount++;
                                audio.currentTime = 0;
                                audio.play().catch(function(){});
                            } else {
                                if(el.musicStatus){
                                    el.musicStatus.innerText = 'Finished';
                                    el.musicStatus.classList.remove('music-playing');
                                }
                            }
                        });
                    }
                    audio.play().catch(function(){});
                } catch {}
            }

            function playNotificationSound(times){
                if(audioBase64){
                    playAudio(audioBase64, times);
                }
            }

            // -------------------------
            // 渲染 Dial（aq4 原样）
            // -------------------------
            function renderDial(stats){
                stats = stats || {};
                const h = Number(stats.h || 0);
                const m = Number(stats.m || 0);
                const cacheMB = Number(stats.cacheMB || 0);
                const hitRate = Number(stats.hitRate || 0);
                const engineInfo = stats.engineInfo || { name:'Node', details:'-' };

                if(el.statTime) el.statTime.textContent = h + 'h ' + m + 'm';
                if(el.statCache) el.statCache.textContent = cacheMB.toFixed(1) + 'MB';
                if(el.statHit) el.statHit.textContent = hitRate.toFixed(1) + '%';
                if(el.statEngine) el.statEngine.textContent = String(engineInfo.name || 'Node');
                if(el.statEngineDetails) el.statEngineDetails.textContent = String(engineInfo.details || '-');
            }

            // -------------------------
            // 渲染 History（aq4 原样：时间 + 预览 + 复制/删除）
            // - 无内联 onclick：全走事件委托
            // -------------------------
            function renderHistory(list){
                const arr = Array.isArray(list) ? list : [];
                if(!el.historyList) return;

                // 尽量保留滚动位置
                const oldScrollTop = el.historyList.scrollTop;

                if(arr.length === 0){
                    el.historyList.innerHTML = '<div style="text-align:center;padding:20px;opacity:0.5;">暂无记录</div>';
                    updateAllScrollbars();
                    return;
                }

                const html = arr.map(function(item){
                    const id = String(item.id || '');
                    const time = String(item.time || '');
                    const preview = escapeHtml(String(item.preview || ''));
                    return (
                        '<div class="history-item" data-id="' + escapeHtml(id) + '">' +
                          '<div class="item-time">' + escapeHtml(time) + '</div>' +
                          '<div class="item-preview">' + preview + '</div>' +
                          '<div class="item-actions">' +
                            '<button class="action-mini-btn" data-action="copy">📋 复制</button>' +
                            '<button class="action-mini-btn" data-action="delete">🗑️ 删除</button>' +
                          '</div>' +
                        '</div>'
                    );
                }).join('');

                el.historyList.innerHTML = html;

                // 恢复滚动
                try { el.historyList.scrollTop = oldScrollTop; } catch {}
                updateAllScrollbars();
            }

            // -------------------------
            // 刷新：把滚动位置发回 extension（aq4 行为保留）
            // -------------------------
            function refreshData(){
                const list = el.historyList;
                const scrollPos = list ? { scrollTop: list.scrollTop, scrollHeight: list.scrollHeight } : null;
                postMessage({ command: 'refresh', scrollPosition: scrollPos });
            }

            // -------------------------
            // Captain：事件委托（cmd-btn）
            // -------------------------
            function bindCaptain(){
                if(!el.captainGrid) return;
                el.captainGrid.addEventListener('click', function(e){
                    const btn = e.target && e.target.closest ? e.target.closest('.cmd-btn') : null;
                    if(!btn) return;
                    const cmd = btn.getAttribute('data-cmd') || '';
                    if(cmd){
                        postMessage({ command: 'executeCommand', cmd: cmd });
                        // aq4 原逻辑：非 savorMoments 才提示音
                        if(cmd !== 'qqq.savorMoments') playNotificationSound(1);
                    }
                });
            }

            // -------------------------
            // History：事件委托（copy/delete）
            // -------------------------
            function bindHistory(){
                if(!el.historyList) return;

                el.historyList.addEventListener('click', function(e){
                    const actionBtn = e.target && e.target.closest ? e.target.closest('button[data-action]') : null;
                    if(!actionBtn) return;

                    const action = actionBtn.getAttribute('data-action') || '';
                    const item = actionBtn.closest('.history-item');
                    const id = item ? (item.getAttribute('data-id') || '') : '';
                    if(!id) return;

                    if(action === 'copy'){
                        postMessage({ command: 'copyToClipboard', itemId: id });
                        playNotificationSound(3);
                    } else if(action === 'delete'){
                        postMessage({ command: 'deleteHistoryItem', itemId: id });
                    }
                });
            }

            // -------------------------
            // 顶部按钮
            // -------------------------
            function bindTopButtons(){
                if(el.btnRefresh) el.btnRefresh.addEventListener('click', function(){ refreshData(); });
                if(el.btnClear) el.btnClear.addEventListener('click', function(){ postMessage({ command: 'clearAllHistory' }); });

                if(el.btnMusicPlay) el.btnMusicPlay.addEventListener('click', function(){
                    // aq4 原行为：播放走命令 savorMoments
                    postMessage({ command: 'executeCommand', cmd: 'qqq.savorMoments' });
                    // 同时如果音频已下发就播（不会破原逻辑）
                    if(audioBase64) playAudio(audioBase64, 0);
                });

                if(el.btnMusicStop) el.btnMusicStop.addEventListener('click', function(){
                    stopMusic();
                });
            }

            // -------------------------
            // Scrollbar Logic（aq4 原样，去掉 onmousedown 直赋值，改 addEventListener）
            // -------------------------
            function setupScrollbar(containerId, scrollbarId, thumbId) {
                const container = document.getElementById(containerId);
                const scrollbar = document.getElementById(scrollbarId);
                const thumb = document.getElementById(thumbId);
                if (!container || !scrollbar || !thumb) return function(){};

                function update() {
                    const ch = container.clientHeight, sh = container.scrollHeight, st = container.scrollTop;
                    if (sh > ch) {
                        scrollbar.style.display = 'block';
                        const th = Math.max(20, (ch / sh) * ch);
                        thumb.style.height = th + 'px';
                        thumb.style.top = (st / (sh - ch)) * (ch - th) + 'px';
                    } else {
                        scrollbar.style.display = 'none';
                    }
                }

                container.addEventListener('scroll', update);

                let isDragging = false, startY = 0, startST = 0;

                thumb.addEventListener('mousedown', function(e){
                    isDragging = true;
                    startY = e.clientY;
                    startST = container.scrollTop;

                    function onMove(ev){
                        if (!isDragging) return;
                        const dy = ev.clientY - startY;
                        const ch = container.clientHeight, sh = container.scrollHeight, th = thumb.offsetHeight;
                        container.scrollTop = startST + (dy / (ch - th)) * (sh - ch);
                        update();
                    }

                    function onUp(){
                        isDragging = false;
                        document.removeEventListener('mousemove', onMove);
                        document.removeEventListener('mouseup', onUp);
                    }

                    document.addEventListener('mousemove', onMove);
                    document.addEventListener('mouseup', onUp);
                    e.preventDefault();
                });

                scrollbar.addEventListener('click', function(e){
                    if (e.target === thumb) return;
                    const rect = scrollbar.getBoundingClientRect();
                    const clickY = e.clientY - rect.top;
                    const ch = container.clientHeight, sh = container.scrollHeight;
                    container.scrollTop = (clickY / ch) * sh - ch / 2;
                    update();
                });

                return update;
            }

            const updateOuter = setupScrollbar('mainContent', 'outerScrollbar', 'outerThumb');
            const updateInner = setupScrollbar('historyList', 'innerScrollbar', 'innerThumb');

            function updateAllScrollbars() {
                try { updateOuter(); } catch {}
                try { updateInner(); } catch {}
            }
            window.addEventListener('resize', updateAllScrollbars);

            // -------------------------
            // 接收扩展端数据
            // -------------------------
            window.addEventListener('message', function(e){
                const m = e.data;
                if(!m || typeof m !== 'object') return;

                if(m.command === 'updateData'){
                    // 音频 base64
                    if(typeof m.audioBase64 === 'string'){
                        audioBase64 = m.audioBase64;
                    }

                    // Dial
                    renderDial(m.stats || {});

                    // History
                    renderHistory(m.history || []);

                    // 恢复滚动位置（aq4 旧逻辑保留，作为兜底）
                    if(m.scrollPosition && el.historyList){
                        try { el.historyList.scrollTop = Number(m.scrollPosition.scrollTop || 0); } catch {}
                    }

                    updateAllScrollbars();
                }

                if(m.command === 'statsSnapshot'){
                    // aq4 UI 没单独 stats 面板，这里不展示；只保留协议兼容
                }
            });

            // 心跳（给 q4 watchdog 用）
            setInterval(function(){
                postMessage({ command: 'heartbeat' });
            }, 10000);

            // 初始化
            bindCaptain();
            bindHistory();
            bindTopButtons();

            updateAllScrollbars();
            postMessage({ command: 'ready' });

            // aq4 原版也会每 5 秒 refreshData，这里保留（不依赖 extension timer 也能动）
            setInterval(function(){
                refreshData();
            }, 5000);

        })();
    </script>
</body>
</html>`;
    }
}






