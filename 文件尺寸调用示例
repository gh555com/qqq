// q2.js (或你的 Node.js 扩展文件) 示例展示了如何通过 Node.js 的 child_process 模块调用修改后的 kp.py 脚本来获取文件大小。
const { spawn } = require('child_process');
const path = require('path'); // 用于处理路径

/**
 * 通过调用 Python 脚本异步计算给定文件/文件夹路径的总大小。
 * @param {string[]} paths - 要计算大小的文件或文件夹路径数组。
 * @returns {Promise<number>} - 解析为总字节大小的 Promise。
 */
function getTotalSizeFromPython(paths) {
    return new Promise((resolve, reject) => {
        // 确保 Python 解释器和 kp.py 脚本的路径正确
        // 在 Windows 上可能是 'python' 或 'python.exe'
        // 在 macOS/Linux 上可能是 'python' 或 'python3'
        const pythonExecutable = 'python';
        // 假设 kp.py 和你的 Node.js 脚本在同一目录下，或者你可以指定完整路径
        const scriptPath = path.join(__dirname, 'kp.py');

        // 构造子进程命令：python kp.py get_size path1 path2 ...
        // 第一个参数 'get_size' 是我们约定好的，告诉 kp.py 执行大小计算功能
        const args = ['get_size', ...paths];

        const pyProcess = spawn(pythonExecutable, [scriptPath, ...args]);

        let stdoutData = '';
        let stderrData = '';

        // 监听 Python 脚本的标准输出
        pyProcess.stdout.on('data', (data) => {
            stdoutData += data.toString();
        });

        // 监听 Python 脚本的标准错误输出 (用于调试)
        pyProcess.stderr.on('data', (data) => {
            stderrData += data.toString();
            console.error(`Python stderr: ${data.toString()}`); // 实时打印 stderr 便于调试
        });

        // 监听子进程关闭事件
        pyProcess.on('close', (code) => {
            if (code === 0) {
                // 脚本成功执行
                try {
                    const result = JSON.parse(stdoutData.trim());
                    if (result.success) {
                        resolve(result.total_size);
                    } else {
                        // Python 脚本内部逻辑失败 (JSON 中有 error 字段)
                        reject(new Error(`Python脚本执行失败: ${result.error || '未知错误'}\nStdout: ${stdoutData}\nStderr: ${stderrData}`));
                    }
                } catch (parseError) {
                    // 解析 JSON 输出失败
                    reject(new Error(`解析Python输出失败: ${parseError.message}\nOutput: ${stdoutData}\nError: ${stderrData}`));
                }
            } else {
                // Python 脚本以非零代码退出，表示运行时错误
                reject(new Error(`Python脚本以非零代码 ${code} 退出。\nStdout: ${stdoutData}\nStderr: ${stderrData}`));
            }
        });

        // 监听子进程启动失败事件 (如 Python 解释器找不到)
        pyProcess.on('error', (err) => {
            reject(new Error(`启动Python进程失败: ${err.message}`));
        });
    });
}

// --- 辅助函数：格式化文件大小显示 ---
function formatSize(bytes) {
    if (bytes === undefined || bytes === null) return "N/A";
    if (bytes < 1024) return `${bytes} B`;
    const kb = bytes / 1024;
    if (kb < 1024) return `${kb.toFixed(2)} KB`;
    const mb = kb / 1024;
    if (mb < 1024) return `${mb.toFixed(2)} MB`;
    const gb = mb / 1024;
    return `${gb.toFixed(2)} GB`;
}

// --- 示例调用 ---
(async () => {
    // 替换为你要计算大小的实际文件或文件夹路径
    const pathsToCalculate = [
        'D:/view/p', // 你的固定输出目录
        'C:/Windows/System32', // 示例系统目录
        // 'C:/Users/Public/Pictures/Sample Pictures/Koala.jpg', // 示例文件
        // 'E:/我的大文件夹' // 另一个大文件夹
    ];

    try {
        console.log(`正在通过Python计算路径 ${pathsToCalculate.join(', ')} 的总大小...`);
        const totalSize = await getTotalSizeFromPython(pathsToCalculate);
        console.log(`计算完成！`);
        console.log(`总大小: ${totalSize} 字节`);
        console.log(`格式化后总大小: ${formatSize(totalSize)}`);

        // 在这里，你可以将 totalSize 更新到你的 VS Code Webview 界面
        // 例如：webview.postMessage({ command: 'updateFileSize', size: formatSize(totalSize) });

    } catch (error) {
        console.error('计算总大小时发生错误:', error.message);
    }
})();

