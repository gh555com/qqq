{
  "name": "qqq",
  "displayName": "qqq",
  "publisher": "gh555",
  "version": "3.0.0",
  "description": "soldier",
  "icon": "assets/icon.png",
  "engines": {
    "vscode": "^1.70.0"
  },
  "activationEvents": [
    "*",
    "onCommand:qqq.q1",
    "onCommand:qqq.q2",
    "onCommand:qqq.pure",
    "onCommand:qqq.allSettings",
    "onCommand:qqq.setInOrder"
  ],
  "main": "./src/qqq.js",
  "contributes": {
    "configuration": [
      {
        "title": "QQQ 扩展设置",
        "properties": {
          "qqq.showHistoryRecycleBin": {
            "type": "boolean",
            "default": true,
            "description": "是否在文件导航中显示历史回收站。"
          },
          "qqq.stretchSmallImages": {
            "type": "boolean",
            "default": true,
            "description": "图片/视频预览时，小于相框（512×288）的图片是否拉伸以填满相框。关闭时，小图保持原尺寸，只在相框中居中摆放。"
          },
          "qqq.extremePerformance": {
            "type": "boolean",
            "default": false,
            "description": "启用极限性能模式：预览生成时尽可能减少计算量（例如将 GIF 预览为静态首帧，并放弃修改后图片的即时刷新），以换取更快的交互响应速度。"
          },
          "qqq.cleanFreak": {
            "type": "boolean",
            "default": false,
            "description": "洁癖（防遮挡）：保存文档前，自动确保所有暗号（/path/）下方有足够空行，防止预览/内容遮挡。相框类型（图片/视频/GIF）计算动态 n（基于字体/行高，约15行）；非相框类型至少1行。只处理下方。"
          }
        }
      }
    ],
    "commands": [
      {
        "command": "qqq.pure",
        "title": "qqq: pure"
      },
      {
        "command": "qqq.allSettings",
        "title": "qqq: all settings"
      },
      {
        "command": "qqq.setInOrder",
        "title": "qqq: set in order (全局整理)"
      }
    ],
    "keybindings": [
      {
        "command": "qqq.q1",
        "key": "ctrl+v",
        "when": "editorTextFocus && !editorReadonly"
      },
      {
        "command": "qqq.q1",
        "key": "cmd+v",
        "when": "editorTextFocus && !editorReadonly"
      },
      {
        "command": "qqq.q2",
        "key": "f2",
        "when": "editorTextFocus && !editorReadonly"
      }
    ]
  },
  "scripts": {
    "package": "npx @vscode/vsce package --allow-missing-repository",
    "publish": "npx @vscode/vsce publish",
    "q": "npx @vscode/vsce publish patch --allow-star-activation",
    "pub": "yes | npx vsce publish patch",
    "test": "echo \"Running tests...\" && exit 0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gh555com/qqq.git"
  },
