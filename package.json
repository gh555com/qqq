{
  "name": "qqq",
  "displayName": "qqq",
  "publisher": "gh555",
  "version": "15.3.1",
  "description": "soldier",
  "icon": "assets/icon.png",
  "engines": {
    "vscode": "^1.70.0"
  },
  "activationEvents": [
    "*",
    "onCommand:qqq.q1",
    "onCommand:qqq.q2",
    "onCommand:qqq.pure",
    "onCommand:qqq.allSettings",
    "onCommand:qqq.setInOrder",
    "onCommand:qqq.openFile",
    "onCommand:qqq.revealFileInFolder",
    "onCommand:qqq.renameFile",
    "onCommand:qqq.exportDoc",
    "onCommand:qqq.exportZip"
  ],
  "main": "./src/qqq.js",
  "contributes": {
    "configuration": [
      {
        "title": "qqq aaa",
        "properties": {
          "qqq.showHistoryRecycleBin": {
            "type": "boolean",
            "default": true,
            "description": "是否在文件导航中显示历史回收站。"
          },
          "qqq.enlargeSmallImages": {
            "type": "boolean",
            "default": true,
            "description": "图片/视频预览时，小于相框（512×288）的图片是否放大以填满相框。关闭时，小图保持原尺寸，只在相框中居中摆放。"
          },
          "qqq.performanceMode": {
            "type": "string",
            "default": "balanced",
            "enum": [
              "extreme",
              "accelerated",
              "balanced"
            ],
            "enumDescriptions": [
              "极限性能：只保留首帧，质量35",
              "加速模式：最多2秒动画，6fps，质量35",
              "最优模式：保留完整动画，视频截取首中尾，质量70"
            ],
            "description": "性能模式：控制预览生成的质量和性能平衡。"
          },
          "qqq.frameSizeMode": {
            "type": "string",
            "default": "smart",
            "enum": [
              "large",
              "small",
              "smart"
            ],
            "enumDescriptions": [
              "大相框：512x288",
              "小相框：256x144",
              "智能：根据图片尺寸自动选择相框"
            ],
            "description": "相框尺寸模式：控制预览图像的显示尺寸。"
          },
          "qqq.cleanFreak": {
            "type": "boolean",
            "default": false,
            "description": "洁癖（防遮挡）：保存文档前，自动确保所有暗号（/path/）下方有足够空行，防止预览/内容遮挡。相框类型（图片/视频/GIF）计算动态 n（基于字体/行高，约15行）；非相框类型至少1行。只处理下方。"
          },
          "qqq.ioEngine": {
            "type": "string",
            "default": "auto",
            "enum": [
              "auto",
              "python",
              "rust",
              "node"
            ],
            "enumDescriptions": [
              "自动选择最佳引擎",
              "Python 引擎",
              "Rust 引擎",
              "Node 引擎"
            ],
            "description": "选择 IO 引擎：控制使用哪种引擎处理剪贴板和文件操作。"
          },
          "qqq.pythonPath": {
            "type": "string",
            "default": "",
            "description": "（可选）指定 python 可执行文件路径。例如：C:\\Python311\\python.exe；留空则自动探测 python/python3/py。"
          },
          "qqq.downloadSecurityLevel": {
            "type": "string",
            "default": "1: 平衡",
            "enum": [
              "0: 最宽松",
              "1: 平衡",
              "2: 最严格"
            ],
            "enumDescriptions": [
              "11项安全开关全部关闭。",
              "11项安全开关开4项，关7项。 \n  \n    开启项包括: \n  . http/https协议限制; \n. 重定向协议限制; \n. 下载锁; \n. Header注入清洗。 ",
              "11项安全开关全部开启。 \n  \n  额外开启滴 7项是: \n . SSRF防护; \n. 路径越界防护; \n. content-length/content-range预检; \n. 严格断点续传; \n. 符号链接防护; \n. yt-dlp probe输出限制; \n. Fail-fast。"
            ],
            "description": "如果下载视频失败，可以在此尝试更宽松滴策略。具体取舍请查看https://github.com/gh555com/qqq/blob/qq/docs/downloadSecurityLevel.md"
          },
          "qqq.enhancedHtmlPasteCompatibility": {
            "type": "boolean",
            "default": false,
            "description": "富文本（html）块粘贴 消除乱码但降低精度。    \n \n  如果您粘贴 html 时遇到乱码，您可以尝试打开本选项，但在其他时候，请保持本选项关闭。 \n  原理：默认会用“评分”体系来猜 html 编码，但有极小几率 猜错，导致乱码。勾选本选项则使用备用方案——先获取纯净文本流，再去猜图片位置，其有助于解决乱码，代价是可能导致图片位置失准。"
          }
        }
      }
    ],
    "commands": [
      {
        "command": "qqq.q1",
        "title": "qqq: Paste (Ctrl+V)"
      },
      {
        "command": "qqq.q2",
        "title": "qqq: Navigate (F2)"
      },
      {
        "command": "qqq.pure",
        "title": "qqq: pure"
      },
      {
        "command": "qqq.allSettings",
        "title": "qqq: all settings"
      },
      {
        "command": "qqq.setInOrder",
        "title": "qqq: set in order (全局整理)"
      },
      {
        "command": "qqq.openFile",
        "title": "qqq: open file"
      },
      {
        "command": "qqq.revealFileInFolder",
        "title": "qqq: reveal in folder"
      },
      {
        "command": "qqq.renameFile",
        "title": "qqq: rename file"
      },
      {
        "command": "qqq.exportDoc",
        "title": "qqq: 导出文档 (Doc/Docx)"
      },
      {
        "command": "qqq.exportZip",
        "title": "qqq: 导出 ZIP"
      }
    ],
    "keybindings": [
      {
        "command": "qqq.q1",
        "key": "ctrl+v",
        "when": "editorTextFocus && !editorReadonly"
      },
      {
        "command": "qqq.q1",
        "key": "cmd+v",
        "when": "editorTextFocus && !editorReadonly"
      },
      {
        "command": "qqq.q2",
        "key": "f2",
        "when": "editorTextFocus && !editorReadonly"
      },
      {
        "command": "qqq.exportDoc",
        "key": "ctrl+alt+p",
        "when": "editorTextFocus"
      }
    ]
  },
  "scripts": {
    "package": "npx @vscode/vsce package --allow-missing-repository --allow-star-activation",
    "publish": "npx @vscode/vsce publish",
    "q": "npx @vscode/vsce publish patch --allow-star-activation",
    "pub": "yes | npx vsce publish patch",
    "test": "echo \"Running tests...\" && exit 0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gh555com/qqq.git"
  },
