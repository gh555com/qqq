{
  "name": "qqq",
  "displayName": "qqq",
  "publisher": "gh555",
  "version": "15.68.20",
  "description": "soldier",
  "icon": "assets/q.gif",
  "engines": {
    "vscode": "^1.73.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/qqq.js",
  "contributes": {
    "colors": [
      {
        "id": "editorCodeLens.foreground",
        "description": "Color of the CodeLens information",
        "defaults": {
          "light": "#FF0000",
          "dark": "#FF0000",
          "highContrast": "#FF0000"
        }
      }
    ],
    "configuration": [
      {
        "title": "%config.title.core%",
        "order": 10,
        "properties": {
          "qqq.language": {
            "order": 5,
            "type": "string",
            "default": "中文",
            "enum": [
              "中文",
              "繁體中文",
              "English",
              "日本語",
              "Deutsch",
              "Русский",
              "العربية",
              "한국어",
              "Español",
              "Français",
              "Português BR"
            ],
            "markdownEnumDescriptions": [
              "%config.language.enum.zh%",
              "%config.language.enum.zh-tw%",
              "%config.language.enum.en%",
              "%config.language.enum.ja%",
              "%config.language.enum.de%",
              "%config.language.enum.ru%",
              "%config.language.enum.ar%",
              "%config.language.enum.ko%",
              "%config.language.enum.es%",
              "%config.language.enum.fr%",
              "%config.language.enum.pt-br%"
            ],
            "markdownDescription": "%config.language.desc%"
          },
          "qqq.performanceMode": {
            "order": 10,
            "type": "string",
            "default": "optmum",
            "enum": [
              "extreme",
              "accelerated",
              "optmum"
            ],
            "markdownEnumDescriptions": [
              "%config.performanceMode.enum.extreme%",
              "%config.performanceMode.enum.accelerated%",
              "%config.performanceMode.enum.optmum%"
            ],
            "markdownDescription": "%config.performanceMode.desc%"
          },
          "qqq.ioEngine": {
            "order": 20,
            "type": "string",
            "default": "auto",
            "enum": [
              "auto",
              "python",
              "rust",
              "node"
            ],
            "markdownEnumDescriptions": [
              "%config.ioEngine.enum.auto%",
              "%config.ioEngine.enum.python%",
              "%config.ioEngine.enum.rust%",
              "%config.ioEngine.enum.node%"
            ],
            "markdownDescription": "%config.ioEngine.desc%"
          },
          "qqq.transactionLevel": {
            "order": 40,
            "type": "string",
            "default": "half",
            "enum": [
              "full",
              "half"
            ],
            "markdownEnumDescriptions": [
              "%config.transactionLevel.enum.full%",
              "%config.transactionLevel.enum.half%"
            ],
            "markdownDescription": "%config.transactionLevel.desc%"
          }
        }
      },
      {
        "title": "%config.title.rover%",
        "order": 20,
        "properties": {
          "qqq.szDisplayMode": {
            "order": 20,
            "type": "string",
            "default": "nothing",
            "enum": [
              "nothing",
              "size",
              "ctime",
              "mtime"
            ],
            "markdownEnumDescriptions": [
              "%config.szDisplayMode.enum.nothing%",
              "%config.szDisplayMode.enum.size%",
              "%config.szDisplayMode.enum.ctime%",
              "%config.szDisplayMode.enum.mtime%"
            ],
            "markdownDescription": "%config.szDisplayMode.desc%"
          },
          "qqq.sortBy": {
            "order": 30,
            "type": "string",
            "default": "name",
            "enum": [
              "name",
              "size",
              "ctime",
              "mtime"
            ],
            "markdownEnumDescriptions": [
              "%config.sortBy.enum.name%",
              "%config.sortBy.enum.size%",
              "%config.sortBy.enum.ctime%",
              "%config.sortBy.enum.mtime%"
            ],
            "markdownDescription": "%config.sortBy.desc%"
          },
          "qqq.autoWatchChanges": {
            "order": 25,
            "type": "boolean",
            "default": false,
            "description": "%config.autoWatchChanges.desc%"
          }
        }
      },
      {
        "title": "%config.title.observe%",
        "order": 30,
        "properties": {
          "qqq.frameSizeMode": {
            "order": 10,
            "type": "string",
            "default": "fix",
            "enum": [
              "large",
              "small",
              "fix"
            ],
            "markdownEnumDescriptions": [
              "%config.frameSizeMode.enum.large%",
              "%config.frameSizeMode.enum.small%",
              "%config.frameSizeMode.enum.fix%"
            ],
            "markdownDescription": "%config.frameSizeMode.desc%"
          },
          "qqq.cleanFreak": {
            "order": 20,
            "type": "string",
            "default": "add",
            "enum": [
              "never",
              "add",
              "add & remove"
            ],
            "markdownEnumDescriptions": [
              "%config.cleanFreak.enum.never%",
              "%config.cleanFreak.enum.add%",
              "%config.cleanFreak.enum.addRemove%"
            ],
            "markdownDescription": "%config.cleanFreak.desc%"
          },
          "qqq.enlargeSmallImages": {
            "order": 30,
            "type": "boolean",
            "default": true,
            "markdownDescription": "%config.enlargeSmallImages.desc%"
          },
          "qqq.textSlideColorScheme": {
            "order": 40,
            "type": "string",
            "default": "light",
            "enum": [
              "light",
              "dark"
            ],
            "markdownDescription": "%config.textSlideColorScheme.desc%"
          },
          "qqq.textSlideFontSize": {
            "order": 50,
            "type": "integer",
            "default": 14,
            "minimum": 1,
            "maximum": 218,
            "markdownDescription": "%config.textSlideFontSize.desc%"
          },
          "qqq.codelensLevel": {
            "order": 60,
            "type": "string",
            "default": "3",
            "enum": [
              "0",
              "1",
              "3"
            ],
            "markdownEnumDescriptions": [
              "%config.codelensLevel.enum.0%",
              "%config.codelensLevel.enum.1%",
              "%config.codelensLevel.enum.3%"
            ],
            "markdownDescription": "%config.codelensLevel.desc%"
          },
          "qqq.takeOverCodelensStyle": {
            "order": 70,
            "type": "boolean",
            "default": true,
            "markdownDescription": "%config.takeOverCodelensStyle.desc%"
          }
        }
      },
      {
        "title": "%config.title.html%",
        "order": 40,
        "properties": {
          "qqq.downloadSecurityLevel": {
            "order": 10,
            "type": "string",
            "default": "1: 平衡",
            "enum": [
              "0: 最宽松",
              "1: 平衡",
              "2: 最严格"
            ],
            "enumDescriptions": [
              "%config.downloadSecurityLevel.enum.0%",
              "%config.downloadSecurityLevel.enum.1%",
              "%config.downloadSecurityLevel.enum.2%"
            ],
            "markdownDescription": "%config.downloadSecurityLevel.desc%"
          },
          "qqq.forceTextFlowScheme": {
            "order": 20,
            "type": "boolean",
            "default": false,
            "markdownDescription": "%config.forceTextFlowScheme.desc%"
          },
          "qqq.autoDownload": {
            "order": 30,
            "type": "boolean",
            "default": true,
            "markdownDescription": "%config.autoDownload.desc%"
          }
        }
      },
      {
        "title": "%config.title.docExport%",
        "order": 50,
        "properties": {
          "qqq.docExportImageResolution": {
            "order": 10,
            "type": "string",
            "default": "original",
            "enum": [
              "original",
              "frame"
            ],
            "enumItemLabels": [
              "%config.docExportImageResolution.label.original%",
              "%config.docExportImageResolution.label.frame%"
            ],
            "markdownDescription": "%config.docExportImageResolution.desc%",
            "markdownEnumDescriptions": [
              "%config.docExportImageResolution.enum.original%",
              "%config.docExportImageResolution.enum.frame%"
            ]
          },
          "qqq.docExportIncludeCipher": {
            "order": 20,
            "type": "boolean",
            "default": true,
            "markdownDescription": "%config.docExportIncludeCipher.desc%"
          }
        }
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "qqqView",
          "title": "qqq",
          "icon": "assets/q4.png"
        }
      ]
    },
    "views": {
      "qqqView": [
        {
          "id": "qqq.Viewq",
          "name": "%view.name%",
          "type": "webview",
          "when": "true"
        }
      ]
    },
    "commands": [
      {
        "command": "qqq.q1",
        "title": "%cmd.q1%"
      },
      {
        "command": "qqq.q2",
        "title": "%cmd.q2%"
      },
      {
        "command": "qqq.pure",
        "title": "%cmd.pure%"
      },
      {
        "command": "qqq.allSettings",
        "title": "%cmd.allSettings%"
      },
      {
        "command": "qqq.weave",
        "title": "%cmd.weave%"
      },
      {
        "command": "qqq.clipboardHistory",
        "title": "%cmd.clipboardHistory%"
      },
      {
        "command": "qqq.exportDoc",
        "title": "%cmd.exportDoc%"
      },
      {
        "command": "qqq.exportZip",
        "title": "%cmd.exportZip%"
      },
      {
        "command": "qqq.downloadVideosFromUrl",
        "title": "%cmd.downloadVideosFromUrl%"
      },
      {
        "command": "qqq.savorMoments",
        "title": "%cmd.savorMoments%"
      },
      {
        "command": "qqq.clearCache",
        "title": "%cmd.clearCache%"
      }
    ],
    "keybindings": [
      {
        "command": "qqq.q1",
        "key": "ctrl+v",
        "when": "editorTextFocus && !editorReadonly"
      },
      {
        "command": "qqq.q1",
        "key": "f2",
        "when": "editorTextFocus && !editorReadonly"
      },
      {
        "command": "qqq.q2",
        "key": "tab",
        "when": "editorTextFocus && !editorReadonly"
      },
      {
        "command": "qqq.q2",
        "key": "f6",
        "when": "editorTextFocus && !editorReadonly"
      }
    ]
  },
  "scripts": {
    "bundle": "node qqqworkflow/esbuild.config.js",
    "ci:test": "vscode-test --config .vscode-test.js",
    "ci:package": "npm run bundle && node -e \"require('fs').mkdirSync('dist',{recursive:true})\" && npx @vscode/vsce package --allow-missing-repository --allow-star-activation -o dist/qqq-${npm_package_version}.vsix",
    "ci:publish": "node qqqworkflow/git_help.js publish",
    "package": "node qqqworkflow/git_help.js package",
    "publish": "npx @vscode/vsce publish --allow-star-activation",
    "q": "npx @vscode/vsce publish patch --allow-star-activation",
    "pub": "yes | npx vsce publish patch",
    "test": "npm run ci:test"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gh555com/qqq.git"
  },
  "extensionKind": [
    "workspace",
    "ui"
  ],
  "categories": [
    "Other",
    "Visualization",
    "Keymaps"
  ],
