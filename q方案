3) ✅ 配套 h：让 h 里的 spawn 默认 NO_TRACK（彻底不污染下载 tracker）

你给的 h.js 很大，但它的关键是这些 spawn helper：

spawnRun

spawnCheck

spawnOutput

把这三段用下面的完整替换块换掉即可（其它 h 保持你原样）。

目的：h 用来跑 powershell/python/小工具时，就算它在下载 scope 内被调用，也不进 tracker，避免误杀/误 track。

// ============================================================================
// Process / Spawn Helpers  (✅ 配套：默认 NO_TRACK，不进入下载任务 tracker)
// ============================================================================
const NO_TRACK_ENV_KEY = "QQQ_NO_TRACK";
function _envNoTrack() {
    return { ...process.env, [NO_TRACK_ENV_KEY]: "1" };
}

function spawnRun(cmd, args, opts = {}) {
    const { checkExpected, returnOutput } = opts;
    return new Promise((resolve) => {
        // ✅ 双保险：显式 env 标记 NO_TRACK
        const child = cp.spawn(cmd, args, {
            windowsHide: true,
            env: _envNoTrack(),
            // detached 默认就是 false；这里不强行写也行
        });

        let output = "";
        let errorOutput = "";
        let done = false;
        let timer = null;

        const finish = (val) => {
            if (done) return;
            done = true;
            if (timer) clearTimeout(timer);
            resolve(val);
        };

        child.stdout.on("data", (d) => output += d.toString());
        child.stderr.on("data", (d) => errorOutput += d.toString());

        child.on("close", () => {
            if (checkExpected) finish(output.includes(checkExpected));
            else finish(returnOutput ? output : "");
        });

        child.on("error", () => {
            finish(checkExpected ? false : "");
        });

        timer = setTimeout(() => {
            try { child.kill(); } catch { }
            finish(checkExpected ? false : "");
        }, 10000);
    });
}

function spawnCheck(cmd, args, expected) {
    return spawnRun(cmd, args, { checkExpected: expected });
}

function spawnOutput(cmd, args) {
    return spawnRun(cmd, args, { returnOutput: true });
}


如果你愿意更彻底一点：你 h.js 里凡是 cp.exec / cp.execFile / cp.execSync / cp.execFileSync 的地方也都可以统一加上：

{ env: _envNoTrack(), windowsHide: true }


但通常只改这三处 helper 已经够把绝大部分外部子进程挡在 tracker 外面了。

你现在得到的行为（逐条对照你的目标）

✅ 只有在 ChildProcessTracker.runWithTracker(task.tracker, async()=>{ ... }) 这个 scope 内启动的 spawn/exec/execFile/fork 才会：

被 track（可 killAll 真取消）

在 detached:true 的情况下被强制修正为 false（且不改原 options）

✅ scope 外（包括其它扩展）调用 child_process：完全不受影响（ALS 前置排除）

✅ 即使 VSCode 某些取消回调脱链：ChildProcessTracker.bind() 也能兜住（最终兜底）



