const cp = require('child_process');
const { AsyncLocalStorage } = require('async_hooks');

const PATCH_KEY = Symbol.for('qqq.cp.patch'); // 全局唯一，防重复 patch

class ChildProcessTracker {
  constructor() {
    this._procs = new Set();
    this._cancelled = false;
  }

  markCancelled() { this._cancelled = true; }
  isCancelled() { return !!this._cancelled; }

  track(proc) {
    if (!proc || typeof proc.pid !== 'number') return;
    this._procs.add(proc);
    const rm = () => this._procs.delete(proc);
    try {
      proc.once('exit', rm);
      proc.once('close', rm);
      proc.once('error', rm);
    } catch (e) {}
  }

  async killAll(reason = '用户取消') {
    this._cancelled = true;

    const pids = [];
    for (const p of Array.from(this._procs)) {
      if (p && typeof p.pid === 'number') pids.push(p.pid);
    }

    for (const pid of pids) await this._killPidTree(pid, false);
    await new Promise(r => setTimeout(r, 400));
    for (const pid of pids) await this._killPidTree(pid, true);

    this._procs.clear();
  }

  async _killPidTree(pid, force) {
    if (!pid || typeof pid !== 'number') return;

    const isWin = process.platform === 'win32';
    if (isWin) {
      return new Promise(resolve => {
        const args = ['/PID', String(pid), '/T'];
        if (force) args.push('/F');
        cp.execFile('taskkill', args, { windowsHide: true }, () => resolve());
      });
    }

    // mac/linux：先杀子再杀父（尽量不误伤）
    try { require('child_process').execFileSync('pkill', [force ? '-KILL' : '-TERM', '-P', String(pid)], { stdio: 'ignore' }); } catch {}
    try { process.kill(pid, force ? 'SIGKILL' : 'SIGTERM'); } catch {}
    // 进程组兜底（多数情况下 -pid 不存在就会抛 ESRCH，被吞掉）
    try { process.kill(-pid, force ? 'SIGKILL' : 'SIGTERM'); } catch {}
  }

  // -------- ALS：让“当前 tracker”只在你的 async 调用链里生效 --------
  static _als = new AsyncLocalStorage();

  static runWith(tracker, fn) {
    ChildProcessTracker.ensurePatched();
    return ChildProcessTracker._als.run(tracker, fn);
  }

  // -------- 只 patch 一次（跨 reload 也防重复）--------
  static ensurePatched() {
    if (globalThis[PATCH_KEY]) return; // 已 patch 过

    const orig = {
      spawn: cp.spawn.bind(cp),
      execFile: cp.execFile.bind(cp),
      exec: cp.exec.bind(cp),
    };

    function getTracker() {
      return ChildProcessTracker._als.getStore() || null;
    }

    cp.spawn = function (...args) {
      // 只在“当前 async 链”有 tracker 时才生效
      const tracker = getTracker();

      // 解析 options
      let file = args[0];
      let spawnArgs = [];
      let options = null;

      if (Array.isArray(args[1])) {
        spawnArgs = args[1];
        if (args[2] && typeof args[2] === 'object') options = args[2];
      } else if (args[1] && typeof args[1] === 'object') {
        options = args[1];
      }

      // ✅ 关键：只在 tracker 存在时才强制 detached=false
      // ✅ 不直接改原 options，避免影响调用方对象
      if (tracker && options && typeof options === 'object') {
        const opt2 = { ...options, detached: false };
        if (Array.isArray(args[1])) args[2] = opt2;
        else args[1] = opt2;
      }

      const p = orig.spawn(...args);
      if (tracker) tracker.track(p);
      return p;
    };

    cp.execFile = function (...args) {
      const tracker = getTracker();
      const p = orig.execFile(...args);
      if (tracker) tracker.track(p);
      return p;
    };

    cp.exec = function (...args) {
      const tracker = getTracker();
      const p = orig.exec(...args);
      if (tracker) tracker.track(p);
      return p;
    };

    // 保存原始函数，方便需要时恢复（可选）
    globalThis[PATCH_KEY] = orig;
  }

  // 可选：在扩展 deactivate 时恢复（更干净）
  static unpatch() {
    const orig = globalThis[PATCH_KEY];
    if (!orig) return;
    cp.spawn = orig.spawn;
    cp.execFile = orig.execFile;
    cp.exec = orig.exec;
    delete globalThis[PATCH_KEY];
  }
}

