_beginTask() {
    // 如果上一任务还在，就先强行取消
    if (this._task && this._task.tracker && !this._task.tracker.isCancelled()) {
        try { this._task.tracker.killAll('新任务覆盖'); } catch (e) { }
    }

    const task = {
        startMs: Date.now(),
        tracker: new ChildProcessTracker()
    };
    this._task = task;
    return task;
}

_endTask() {
    this._task = null;
}

2.2 把 start() 变成：整段下载逻辑跑在 ALS.run(scope) 里

