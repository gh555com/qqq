## 📝 具体实现

### q2.js（极简版）

```javascript
function showQ2Dialog(context) {
    const panel = vscode.window.createWebviewPanel(
        'q2Dialog',
        'Q2 文件浏览',
        vscode.ViewColumn.One,
        { enableScripts: true }
    );

    // 1. 读取 HTML 模板
    const htmlPath = path.join(context.extensionPath, 'q2.html');
    let html = fs.readFileSync(htmlPath, 'utf8');

    // 2. 只注入必要的初始数据（通过 data 属性）
    const config = getConfig();
    html = html.replace(
        '<body>',
        `<body data-size-mode="${config.sizeMode}"
               data-current-path="${config.currentPath}"
               data-line-spacing="${config.lineSpacing}">`
    );

    panel.webview.html = html;

    // 3. 后续通过消息通信
    panel.webview.onDidReceiveMessage(message => {
        // 处理来自 webview 的消息
    });
}
```

