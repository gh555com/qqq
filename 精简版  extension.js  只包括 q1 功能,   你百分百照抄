        .footer {
            padding: 10px;
            background-color: #fff;
            border-top: 1px solid #dee2e6;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .filename-input-container {
            flex: 1;
            margin-right: 10px;
        }
        .filename-label {
            font-size: 13px;
            color: #666;
            margin-bottom: 3px;
            display: block;
        }
        .filename-input {
            width: 100%;
            padding: 5px;
            border: 1px solid #ced4da;
            border-radius: 3px;
            font-size: 14px;
        }
