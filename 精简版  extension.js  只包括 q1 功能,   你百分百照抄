            const isImage = ['.png', '.jpg', '.jpeg', '.gif', '.bmp', '.webp', '.ico', '.tiff', '.tif'].includes(ext);

            // 创建装饰对象
            const deco = {
                range: decoRange,
                renderOptions: {}
            };

            // 所有资源类型统一处理方式，保持原始文字显示
            if (isImage) {
                try {
                    if (sharp) {
                        // 统一目标尺寸：512x288
                        const TARGET_WIDTH = 512;
