// 读取最近保存的目录
function getRecentDirectories() {
    const configPath = 'E:\\r\\pz.ini';
    const recentDirs = [];

    try {
        if (!fs.existsSync(configPath)) {
            // 创建目录和配置文件
            fs.mkdirSync(path.dirname(configPath), { recursive: true });
            fs.writeFileSync(configPath, '[qqq]\nrecent_dirs=\n', 'utf8');
            return recentDirs;
        }

        const content = fs.readFileSync(configPath, 'utf8');
        const qqqSection = content.match(/\[qqq\]([\s\S]*?)(\[|$)/);

        if (qqqSection && qqqSection[1]) {
            const recentMatch = qqqSection[1].match(/recent_dirs=(.*)/);
            if (recentMatch && recentMatch[1]) {
                recentDirs.push(...recentMatch[1].split(',').filter(dir => dir && fs.existsSync(dir)).slice(0, 10));
            }
        }
    } catch (error) {
        logMessage('读取配置文件失败: ' + error.message, 'ERROR');
    }

    return recentDirs;
}

// 保存最近使用的目录
function saveRecentDirectory(directory) {
    const configPath = 'E:\\r\\pz.ini';

    try {
        if (!fs.existsSync(configPath)) {
            fs.mkdirSync(path.dirname(configPath), { recursive: true });
            fs.writeFileSync(configPath, `[qqq]\nrecent_dirs=${directory}\n`, 'utf8');
            return;
        }

        let content = fs.readFileSync(configPath, 'utf8');
        let qqqSection = content.match(/\[qqq\]([\s\S]*?)(\[|$)/);
        let recentDirs = [];

        if (qqqSection && qqqSection[1]) {
            const recentMatch = qqqSection[1].match(/recent_dirs=(.*)/);
            if (recentMatch && recentMatch[1]) {
                recentDirs = recentMatch[1].split(',').filter(dir => dir && dir !== directory);
            }
        }

        // 添加新目录到开头并限制为10个
        recentDirs.unshift(directory);
        recentDirs = recentDirs.slice(0, 10);

        const recentDirsStr = recentDirs.join(',');

        if (qqqSection) {
            // 替换现有的recent_dirs行
            const newQqqSection = qqqSection[1].replace(/recent_dirs=.*$/m, `recent_dirs=${recentDirsStr}`);
            content = content.replace(/\[qqq\]([\s\S]*?)(\[|$)/, `[qqq]${newQqqSection}$2`);
        } else {
            // 添加新的qqq节
            content += `\n[qqq]\nrecent_dirs=${recentDirsStr}\n`;
        }

        fs.writeFileSync(configPath, content, 'utf8');
    } catch (error) {
        logMessage('保存配置文件失败: ' + error.message, 'ERROR');
    }
}

// 获取驱动器列表（Windows系统）
function getDrives() {
    const drives = [];

    if (process.platform === 'win32') {
        try {
            const child = cp.spawnSync('wmic', ['logicaldisk', 'get', 'caption'], { encoding: 'utf8' });
            const output = child.stdout;

            // 解析输出，获取驱动器列表
            const lines = output.split('\n');
            for (const line of lines) {
                const driveMatch = line.match(/([A-Z]:)/);
                if (driveMatch) {
                    drives.push(driveMatch[1]);
                }
            }
        } catch (error) {
            logMessage('获取驱动器列表失败: ' + error.message, 'ERROR');
            // 默认添加C盘
            drives.push('C:');
        }
    } else {
        // 非Windows系统，默认添加根目录
        drives.push('/');
    }

    return drives;
}

// 获取目录树结构
function getDirectoryStructure(dirPath, depth = 0, maxDepth = 2) {
    const structure = {
        path: dirPath,
        name: path.basename(dirPath),
        isDir: true,
        children: []
    };

    if (depth >= maxDepth) {
        return structure;
    }

    try {
        const entries = fs.readdirSync(dirPath, { withFileTypes: true });
        const dirEntries = entries.filter(entry => entry.isDirectory());

        for (const dirEntry of dirEntries) {
            try {
                const childPath = path.join(dirPath, dirEntry.name);
                const childStat = fs.statSync(childPath);
                if (childStat.isDirectory()) {
                    structure.children.push(getDirectoryStructure(childPath, depth + 1, maxDepth));
                }
            } catch (error) {
                // 忽略无法访问的目录
            }
        }
    } catch (error) {
        logMessage(`读取目录结构失败: ${dirPath}`, 'ERROR');
    }

    return structure;
}

// 获取目录内容
function getDirectoryContents(dirPath) {
    const contents = {
        dirs: [],
        files: []
    };

    try {
        const entries = fs.readdirSync(dirPath, { withFileTypes: true });

        for (const entry of entries) {
            const entryPath = path.join(dirPath, entry.name);

            try {
                const stat = fs.statSync(entryPath);

                if (entry.isDirectory()) {
                    contents.dirs.push({
                        name: entry.name,
                        path: entryPath,
                        isDir: true,
                        size: stat.size,
                        mtime: stat.mtime.toISOString()
                    });
                } else {
                    contents.files.push({
                        name: entry.name,
                        path: entryPath,
                        isDir: false,
                        size: stat.size,
                        mtime: stat.mtime.toISOString()
                    });
                }
            } catch (error) {
                // 忽略无法访问的文件/目录
            }
        }

        // 排序：文件夹在前，按名称排序
        contents.dirs.sort((a, b) => a.name.localeCompare(b.name));
        contents.files.sort((a, b) => a.name.localeCompare(b.name));
    } catch (error) {
        logMessage(`读取目录内容失败: ${dirPath}`, 'ERROR');
    }

    return contents;
}

